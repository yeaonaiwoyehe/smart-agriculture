<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.4318">
        <ImageButton
            android:elevation="5dp"
            android:id="@+id/iv_agricultural_machinery_back"
            android:layout_marginStart="13dp"
            android:layout_marginTop="9dp"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/back"
            android:background="@null"
            android:src="@mipmap/back"/>
        <ImageButton
            android:src="@mipmap/share"
            android:elevation="5dp"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="13dp"
            android:layout_marginTop="9dp"
            android:id="@+id/iv_agricultural_machinery_share"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/share"
            android:background="@null"/>
        <FrameLayout
            android:id="@+id/frame_image_agricultural_machinery"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="4dp">
            <com.youth.banner.Banner
                android:id="@+id/banner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
    </RelativeLayout>
    <LinearLayout
        android:layout_marginTop="12dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.3324"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="0.03562"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="0.92875"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.1609"
                android:orientation="horizontal">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView
                        android:background="@drawable/style_icon_bigger"
                        android:layout_width="4dp"
                        android:layout_height="27dp"/>
                    <TextView
                        android:layout_marginStart="12dp"
                        android:text="@string/detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textStyle="bold"/>
                </RelativeLayout>
            </LinearLayout>
            <LinearLayout
                android:background="@drawable/style_detail_page"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.1609"
                android:orientation="horizontal">
                <RelativeLayout
                    android:background="@drawable/style_detail_page"
                    android:layout_width="0dp"
                    android:layout_weight="0.3452"
                    android:layout_height="match_parent">
                    <TextView
                        android:layout_centerVertical="true"
                        android:layout_centerHorizontal="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/agricultural_machinery_model"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                </RelativeLayout>
                <RelativeLayout
                    android:background="@drawable/style_detail_page"
                    android:layout_width="0dp"
                    android:layout_weight="0.6547"
                    android:layout_height="match_parent">
                    <TextView
                        android:layout_centerHorizontal="true"
                        android:layout_centerVertical="true"
                        android:id="@+id/tv_detail_page_machinery_model"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"/>
                </RelativeLayout>
            </LinearLayout>
            <LinearLayout
                android:background="@drawable/style_detail_page_grey"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.1915">
                <RelativeLayout
                    android:background="@drawable/style_detail_page_grey"
                    android:layout_width="0dp"
                    android:layout_weight="0.3452"
                    android:layout_height="match_parent">
                    <TextView
                        android:layout_centerVertical="true"
                        android:layout_centerHorizontal="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/operable_crops"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                </RelativeLayout>
                <RelativeLayout
                    android:background="@drawable/style_detail_page_grey"
                    android:layout_width="0dp"
                    android:layout_weight="0.6547"
                    android:layout_height="match_parent">
                    <TextView
                        android:id="@+id/tv_detail_page_operable_crops"
                        android:layout_centerVertical="true"
                        android:layout_centerHorizontal="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"/>
                </RelativeLayout>
            </LinearLayout>
            <LinearLayout
                android:background="@drawable/style_detail_page"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.2873">
                <RelativeLayout
                    android:background="@drawable/style_detail_page"
                    android:layout_width="0dp"
                    android:layout_weight="0.3452"
                    android:layout_height="match_parent">
                    <TextView
                        android:layout_centerHorizontal="true"
                        android:layout_centerVertical="true"
                        android:text="@string/work_area"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </RelativeLayout>
                <RelativeLayout
                    android:background="@drawable/style_detail_page"
                    android:layout_width="0dp"
                    android:layout_weight="0.6547"
                    android:layout_height="match_parent">
                    <TextView
                        android:id="@+id/tv_detail_page_work_area"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:layout_centerVertical="true"
                        android:layout_centerHorizontal="true"/>
                </RelativeLayout>
            </LinearLayout>
            <LinearLayout
                android:background="@drawable/style_detail_page_grey"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.1992">
                <RelativeLayout
                    android:background="@drawable/style_detail_page_grey"
                    android:layout_width="0dp"
                    android:layout_weight="0.3452"
                    android:layout_height="match_parent">
                    <TextView
                        android:text="@string/equipped_grain_truck"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_centerVertical="true"
                        android:layout_centerHorizontal="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </RelativeLayout>
                <RelativeLayout
                    android:background="@drawable/style_detail_page_grey"
                    android:layout_width="0dp"
                    android:layout_weight="0.6547"
                    android:layout_height="match_parent">
                    <TextView
                        android:id="@+id/tv_detail_page_equipped_grain_truck"
                        android:layout_centerHorizontal="true"
                        android:layout_centerVertical="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="0.03562"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.1350"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.0687"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">
        <RelativeLayout
            android:id="@+id/rl_detail_page_inquire"
            android:layout_width="0dp"
            android:layout_weight="0.3307"
            android:layout_height="match_parent">
            <ImageView
                android:src="@mipmap/tip"
                android:layout_above="@id/tv_inquire"
                android:layout_centerHorizontal="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/please_inquire" />
            <TextView
                android:id="@+id/tv_inquire"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/please_inquire"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_detail_page_call"
            android:background="@drawable/style_fm_line_first"
            android:layout_width="0dp"
            android:layout_weight="0.6693"
            android:layout_height="match_parent">
            <ImageView
                android:layout_marginEnd="5dp"
                android:src="@mipmap/phone"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/tv_phone_inquire"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/telephone_contact" />
            <TextView
                android:id="@+id/tv_phone_inquire"
                android:layout_centerVertical="true"
                android:layout_centerHorizontal="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/telephone_contact"
                android:textSize="20sp"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
