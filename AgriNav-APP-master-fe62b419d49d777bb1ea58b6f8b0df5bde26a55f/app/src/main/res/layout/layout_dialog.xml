<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/dialog_width"
    android:layout_height="@dimen/dialog_height"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:cardCornerRadius="@dimen/dialog_conner">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/layout_button_group">
            <TextView
                android:id="@+id/dialog_text_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="3dp"
                android:textSize="@dimen/dialog_size_max"
                android:textStyle="bold"
                tools:text="温馨提示" />

            <TextView
                android:paddingHorizontal="@dimen/dialog_padding_horizontal"
                android:id="@+id/dialog_text_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/dialog_text_title"
                android:layout_centerHorizontal="true"
                android:paddingVertical="@dimen/dialog_padding_text_vertical"
                android:textSize="@dimen/dialog_size_min"
                android:textAlignment="center"
                tools:text="这里是要提示的内容" />
        </RelativeLayout>
        <LinearLayout
            android:id="@+id/layout_button_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/dialog_padding_horizontal"
            android:paddingBottom="@dimen/dialog_padding_vertical"
            android:layout_marginBottom="@dimen/margin_component_small">

            <Button
                android:id="@+id/dialog_button_yes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="0dp"
                android:paddingVertical="8dp"
                tools:text="去设置" />

            <Button
                style="?attr/materialButtonOutlinedStyle"
                app:strokeColor="@color/green"
                android:id="@+id/dialog_button_no"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dialog_padding_vertical"
                android:minHeight="0dp"
                android:paddingVertical="8dp"
                tools:text="取消" />
        </LinearLayout>
    </RelativeLayout>
</androidx.cardview.widget.CardView>