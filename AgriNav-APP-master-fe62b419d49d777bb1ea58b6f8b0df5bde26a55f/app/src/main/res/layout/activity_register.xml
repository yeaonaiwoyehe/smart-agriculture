<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:id="@+id/snack_bar_container_register"
        android:layout_marginTop="100dp"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:orientation="horizontal"
        android:visibility="invisible">
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@mipmap/bg">
    </LinearLayout>
    <TextView
        android:id="@+id/tv_register_phone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="15531069469"
        android:textColor="@color/black_text"
        android:fontFamily="@font/ping_fang"
        android:textStyle="bold"
        android:textSize="@dimen/login_register_text_size"
        android:layout_centerHorizontal="true"
        android:layout_above="@id/ll_register_btn_group"
        android:layout_marginBottom="@dimen/register_text_view_phone_margin_bottom"/>
    <LinearLayout
        android:id="@+id/ll_register_btn_group"
        android:layout_width="@dimen/login_register_btn_width"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical">
        <Button
            android:id="@+id/btn_register_this"
            android:text="@string/register_register_this"
            android:fontFamily="@font/ping_fang"
            android:textSize="@dimen/login_register_btn_text_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <Button
            android:id="@+id/btn_register_other"
            android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar.Bridge"
            android:text="@string/register_register_other"
            android:fontFamily="@font/ping_fang"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/black_text"
            android:textSize="@dimen/login_register_btn_text_size"
            android:background="@drawable/style_button"
            android:backgroundTintMode="multiply"
            android:layout_marginVertical="@dimen/login_register_btn_margin_vertical"/>
    </LinearLayout>
<!--    下面是服务条款-->
    <LinearLayout
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/ll_register_btn_group">
        <CheckBox
            android:id="@+id/rb_register_protocol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/protocol_ok"
            android:fontFamily="@font/ping_fang"
            android:button="@drawable/icon_protocol_selector"
            android:paddingStart="@dimen/protocol_margin_or_padding"
            android:textSize="@dimen/protocol_text_size"
            tools:ignore="RtlSymmetry" />
        <TextView
            android:id="@+id/tv_register_read_protocol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/protocol_see"
            android:fontFamily="@font/ping_fang"
            android:textSize="@dimen/protocol_text_size"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tv_register_read_protocol_personal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/protocol_personal_see"
            android:fontFamily="@font/ping_fang"
            android:textSize="@dimen/protocol_text_size"
            android:textStyle="bold" />
    </LinearLayout>
</RelativeLayout>