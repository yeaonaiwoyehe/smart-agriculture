<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_height="match_parent"
    android:layout_width="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@mipmap/bg">
    </LinearLayout>
    <TextView
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:text="@string/login_welcome"
        android:textSize="@dimen/login_register_text_size"
        android:layout_alignStart="@id/rl_login_center"
        android:layout_marginVertical="@dimen/login_register_text_view_string_margin_small"
        android:fontFamily="@font/ping_fang"
        android:textStyle="bold"
        android:textColor="@color/black_text"
        android:layout_above="@id/login_toast"
        />
    <LinearLayout
        android:id="@+id/login_toast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/rl_login_center"
        android:layout_alignStart="@id/rl_login_center"
        android:layout_marginBottom="@dimen/login_register_text_view_string_margin_big">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_account_text"
            android:textColor="@color/black_text"
            android:textSize="@dimen/login_register_text_view_string_size" />
        <TextView
            android:id="@+id/tv_login_to_register"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_account_register"
            android:textColor="@color/green"
            android:textSize="@dimen/login_register_text_view_string_size"
            android:fontFamily="@font/ping_fang"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/rl_login_center"
        android:layout_width="@dimen/login_register_btn_width"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edt_login_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/login_edit_hint"
            android:textColorHint="@color/grey_hint"
            android:textColor="@color/black_text"
            android:inputType="phone"
            android:fontFamily="@font/ping_fang"
            android:textSize="@dimen/login_register_edt_text_size" />
        <Button
            android:id="@+id/btn_login_confirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/login_btn_confirm_text"
            android:textColor="@color/white"
            android:textSize="@dimen/login_register_btn_text_size"
            android:fontFamily="@font/ping_fang"
            android:layout_marginVertical="@dimen/login_register_btn_margin_vertical"/>
    </LinearLayout>
</RelativeLayout>
