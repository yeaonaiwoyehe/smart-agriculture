<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="170dp"
    android:layout_height="221dp"
    android:background="@drawable/style_grid_machinery_item">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/machinery_picture"
        android:layout_width="170dp"
        android:layout_height="121dp"
        android:contentDescription="@string/photos_agricultural_machinery"
        android:scaleType="center"
        android:layout_gravity="center"
        app:shapeAppearance="@style/common"/>
    <RelativeLayout
        android:id="@+id/rl_machinery_model_number"
        android:background="@drawable/style_machinery_tv_model_number"
        android:layout_marginTop="12dp"
        android:layout_marginStart="9dp"
        android:layout_below="@+id/machinery_picture"
        android:layout_width="66dp"
        android:layout_height="22dp">
        <TextView
            android:id="@+id/tv_machinery_model_number"
            android:layout_centerVertical="true"
            android:layout_centerHorizontal="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:text="@string/agricultural_machinery_model"
            android:textSize="10sp"/>
    </RelativeLayout>
    <TextView
        android:id="@+id/tv_machinery_model_number_edit"
        android:layout_marginTop="16dp"
        android:layout_marginStart="17dp"
        android:layout_below="@+id/machinery_picture"
        android:layout_toEndOf="@id/rl_machinery_model_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="13sp"/>
    <RelativeLayout
        android:id="@+id/rl_machinery_region"
        android:background="@drawable/style_machinery_tv_region"
        android:layout_marginStart="9dp"
        android:layout_below="@+id/rl_machinery_model_number"
        android:layout_marginTop="12dp"
        android:layout_width="66dp"
        android:layout_height="22dp">
        <TextView
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:text="@string/operable_area"
            android:textSize="10sp"/>
    </RelativeLayout>
    <TextView
        android:id="@+id/tv_machinery_region"
        android:layout_marginStart="17dp"
        android:layout_marginTop="15dp"
        android:layout_below="@+id/tv_machinery_model_number_edit"
        android:layout_toEndOf="@id/rl_machinery_region"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="13sp"/>
    <TextView
        android:layout_marginStart="13dp"
        android:layout_marginTop="8dp"
        android:layout_below="@id/rl_machinery_region"
        android:id="@+id/tv_date_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="10sp"/>
</RelativeLayout>