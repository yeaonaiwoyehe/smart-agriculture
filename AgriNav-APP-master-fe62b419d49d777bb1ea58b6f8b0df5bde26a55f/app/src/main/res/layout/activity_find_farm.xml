<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/find_farm_drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/find_farm_title"
            android:background="@drawable/style_fm_line_first"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/find_farm_padding_horizontal">

            <ImageView
                android:id="@+id/iv_farm_add"
                android:layout_width="@dimen/find_farm_image_size"
                android:layout_height="@dimen/find_farm_image_size"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:src="@mipmap/add" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="4"
                android:gravity="center"
                android:text="@string/find_farm_head"
                android:textColor="@color/white"
                android:textSize="@dimen/find_farm_top_title_size"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/iv_farm_search"
                android:layout_width="@dimen/find_farm_image_size"
                android:layout_height="@dimen/find_farm_image_size"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@mipmap/sort_white" />


        </LinearLayout>


        <com.scwang.smart.refresh.layout.SmartRefreshLayout
            android:id="@+id/find_farm_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.scwang.smart.refresh.header.ClassicsHeader
                android:id="@+id/grid_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <GridView
                android:id="@+id/gv_find_farm"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/find_farm_grid_layout_margin"
                android:horizontalSpacing="@dimen/find_farm_horizontal_spacing"
                android:numColumns="2"
                android:verticalSpacing="@dimen/find_farm_vertical_spacing" />


            <com.scwang.smart.refresh.footer.ClassicsFooter
                android:id="@+id/find_farm_grid_footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </com.scwang.smart.refresh.layout.SmartRefreshLayout>

    </LinearLayout>
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_find_farm_select"
        android:layout_width="wrap_content"
        app:headerLayout="@layout/navigation_find_farm_select"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        />
</androidx.drawerlayout.widget.DrawerLayout>