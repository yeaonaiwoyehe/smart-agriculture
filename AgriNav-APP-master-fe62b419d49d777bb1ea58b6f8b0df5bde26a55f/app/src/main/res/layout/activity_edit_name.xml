<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="@dimen/personal_margin_around_mid"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/personal_margin_around_mid"
        android:gravity="center"
        android:text="@string/personal_info_change_name"
        android:textSize="@dimen/personal_size_text_max"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edt_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/personal_info_edit_name"
        android:textSize="@dimen/personal_size_text_max" />

    <Button
        android:id="@+id/btn_ok"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/personal_margin_around_mid"
        android:text="@string/personal_info_btn_ok"
        android:textSize="@dimen/personal_size_text_mid" />

</LinearLayout>