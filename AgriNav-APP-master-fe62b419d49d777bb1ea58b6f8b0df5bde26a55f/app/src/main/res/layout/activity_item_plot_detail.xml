<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".front.activity.plot.ItemPlotDetail"
    android:orientation="vertical">
    <com.amap.api.maps.MapView
        android:id="@+id/map_plot_detail"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/plot_linear"
        android:paddingVertical="@dimen/margin_component_tiny">
        <TextView
            android:layout_width="0dp"
            android:layout_weight="2"
            android:layout_height="match_parent"
            android:text="@string/area"
            android:textStyle="bold"
            android:textSize="@dimen/trajectory_fragment_text_mid"
            android:gravity="center"/>
        <TextView
            android:id="@+id/tv_plot_detail_area"
            android:layout_width="0dp"
            android:layout_weight="3"
            android:layout_height="match_parent"
            android:textSize="@dimen/trajectory_fragment_text_mid"
            android:gravity="center"/>
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:textSize="@dimen/trajectory_fragment_text_mid"
            android:textStyle="bold"
            android:text="@string/areaUnit"
            android:gravity="center"/>
    </LinearLayout>
</LinearLayout>