<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <ImageButton
        android:layout_marginTop="@dimen/btn_margin_top1"
        android:layout_marginLeft="@dimen/btn_margin_left1"
        android:id="@+id/buttonMeasure"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@mipmap/gauge" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/tv_margin_left1"
        android:text="@string/measureOne"
        android:textSize="14dp"/>
</LinearLayout>