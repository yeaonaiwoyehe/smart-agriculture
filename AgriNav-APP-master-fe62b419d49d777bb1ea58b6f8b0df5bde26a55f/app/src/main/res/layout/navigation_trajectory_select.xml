<!--手机输入框-->
        <LinearLayout
            android:id="@+id/ll_trajectory_navigation_item_phone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/navigation_item_height"
            android:layout_below="@id/ll_trajectory_navigation_item_address"
            android:layout_marginBottom="@dimen/trajectory_font_item_padding"
            android:orientation="horizontal"
            android:background="@color/white"
            android:paddingHorizontal="@dimen/trajectory_font_item_padding">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="@integer/trajectory_weight_small"
                android:text="@string/navigation_item_text_phone"
                android:textSize="@dimen/trajectory_fragment_text_small"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edt_trajectory_navigation_item_phone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="@integer/trajectory_weight_mid_b"
                android:gravity="center_vertical"
                android:hint="@string/navigation_item_hint_phone"
                android:inputType="phone"
                android:padding="@dimen/trajectory_font_item_padding"
                android:textSize="@dimen/trajectory_fragment_text_small" />
        </LinearLayout>
<!--按钮框-->
        <LinearLayout
            android:id="@+id/ll_trajectory_navigation_item_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/ll_trajectory_navigation_item_phone"
            android:layout_marginBottom="@dimen/trajectory_font_item_padding"
            android:orientation="horizontal"
            android:padding="@dimen/trajectory_font_item_padding">

            <Button
                android:id="@+id/btn_trajectory_navigation_item_cancel"
                style="?attr/materialIconButtonOutlinedStyle"
                android:backgroundTint="@color/white"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="@integer/trajectory_weight_small"
                android:textColor="@color/black_text"
                android:text="@string/navigation_item_btn_text_cancel"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_trajectory_navigation_item_return"
                style="?attr/materialIconButtonOutlinedStyle"
                android:backgroundTint="@color/white"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="@integer/trajectory_weight_small"
                android:text="@string/navigation_item_btn_text_return"
                android:textColor="@color/black_text"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_trajectory_navigation_item_ok"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="@integer/trajectory_weight_small"
                android:text="@string/navigation_item_btn_text_ok"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/ll_trajectory_navigation_item_btn"
            android:layout_marginBottom="@dimen/trajectory_font_item_padding"
            android:orientation="horizontal"
            android:padding="@dimen/trajectory_font_item_padding">
        </LinearLayout>
    </RelativeLayout>


</androidx.coordinatorlayout.widget.CoordinatorLayout>
