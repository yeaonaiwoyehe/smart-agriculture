<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sidebar"
    android:fitsSystemWindows="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <!--            第一行：地块类型筛选-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/measure_type_line_height"
            android:layout_marginTop="@dimen/measure_type_line_marginTop"
            android:orientation="horizontal">
                <TextView
                    android:layout_width="@dimen/icon_width"
                    android:layout_height="@dimen/icon_height"
                    android:layout_marginStart="@dimen/icon_marginLeft"
                    android:layout_marginTop="@dimen/icon_marginTop"
                    android:background="@drawable/style_icon"/>
                <TextView
                    android:layout_marginStart="@dimen/measure_text_marginLeft"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/measure_type_line_height"
                    android:text="@string/measure_type"
                    android:textStyle="bold"
                    android:textSize="@dimen/measure_type_size"/>
        </LinearLayout>
<!--           第二行地块类型选择-->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/measure_choose"
            android:layout_marginTop="@dimen/measure_plot_choose_line_marginTop"
            android:background="@color/white">
            <TextView
                android:layout_marginStart="@dimen/measure_plot_choose_line_text_marginLeft"
                android:layout_marginTop="@dimen/measure_plot_choose_line_text_marginTop"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/measure_plot_choose_line_text_height"
                android:textSize="@dimen/gridView_item_area_relative_obtain_text_size"
                android:textStyle="bold"
                android:text="@string/measure_type_text"/>
            <RelativeLayout
                android:id="@+id/rl_choose_type"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="@dimen/measure_plot_choose_line_text_marginTop"
                android:layout_marginEnd="@dimen/measure_type_plot_choose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:ignore="RelativeOverlap">
                <TextView
                    android:id="@+id/spinner"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/measure_info_re_height"
                    android:hint="@string/choose_type"
                    android:textSize="@dimen/gridView_item_area_relative_obtain_text_size"/>
                <ImageButton
                    style="?attr/materialIconButtonStyle"
                    android:id="@+id/btn_Type"
                    android:layout_toEndOf="@id/spinner"
                    android:layout_width="@dimen/measure_enter_imageButton"
                    android:layout_height="@dimen/measure_enter_imageButton"
                    android:contentDescription="@string/choose_type"
                    android:src="@mipmap/enter"/>
            </RelativeLayout>
        </RelativeLayout>
        <LinearLayout
            android:layout_marginTop="@dimen/spinner_linearLayout_marginTop"
            android:layout_width="match_parent"
            android:layout_height="@dimen/measure_plot_choose_line_text_height"
            android:orientation="horizontal">
            <TextView
                android:layout_width="@dimen/icon_width"
                android:layout_height="@dimen/icon_height"
                android:layout_marginStart="@dimen/icon_marginLeft"
                android:layout_marginTop="@dimen/icon_marginTop"
                android:background="@drawable/style_icon"/>
            <TextView
                android:layout_marginStart="@dimen/measure_text_marginLeft"
                android:layout_width="match_parent"
                android:layout_height="@dimen/measure_type_line_height"
                android:text="@string/measure_area"
                android:textStyle="bold"
                android:textSize="@dimen/measure_type_size"/>
        </LinearLayout>
        <LinearLayout
            android:layout_marginTop="@dimen/measure_plot_choose_line_marginTop"
            android:layout_width="match_parent"
            android:layout_height="@dimen/measure_plot_area_line_height"
             android:background="@color/white"
            android:orientation="horizontal">
                <TextView
                    android:layout_marginTop="@dimen/measure_plot_area_edit_marginTop"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/measure_plot_choose_line_text_height"
                    android:layout_marginStart="@dimen/measure_plot_area_edit_marginLeft"
                    android:text="@string/draw_area_from"
                    android:textSize="@dimen/gridView_item_area_relative_obtain_text_size"/>
                <EditText
                    android:layout_marginTop="@dimen/measure_plot_area_edit_input_marginTop"
                    android:layout_marginStart="@dimen/measure_plot_area_edit_input_marginLeft"
                    android:id="@+id/editFirstArea"
                    android:autofillHints="@string/measure_area_hint_text"
                    android:background="@drawable/style_spinner_type"
                    android:layout_width="@dimen/measure_plot_edit_width"
                    android:layout_height="@dimen/measure_plot_edit_height"
                    android:inputType="numberDecimal"
                    android:gravity="center"
                    android:hint="@string/measure_area_hint_text"
                    android:textSize="@dimen/gridView_item_area_relative_obtain_text_size"/>
                <TextView
                    android:layout_marginTop="@dimen/measure_plot_area_edit_marginTop"
                    android:layout_width="@dimen/measure_plot_area_edit_width"
                    android:layout_height="wrap_content"
                    android:text="@string/draw_area_to"
                    android:textSize="@dimen/gridView_item_area_relative_obtain_text_size"
                    android:layout_marginStart="@dimen/measure_plot_area_edit_input_marginLeft"/>
                <EditText
                    android:layout_marginTop="@dimen/measure_plot_area_edit_input_marginTop"
                    android:id="@+id/editEndArea"
                    android:autofillHints="@string/measure_area_hint_text"
                    android:background="@drawable/style_spinner_type"
                    android:layout_width="@dimen/measure_plot_edit_width"
                    android:layout_height="@dimen/measure_plot_edit_height"
                    android:inputType="numberDecimal"
                    android:paddingBottom="@dimen/draw_area"
                    android:paddingTop="@dimen/draw_area"
                    android:gravity="center"
                    android:hint="@string/measure_area_hint_text"
                    android:textSize="@dimen/gridView_item_area_relative_obtain_text_size"/>
        </LinearLayout>
        <LinearLayout
            android:layout_marginTop="@dimen/spinner_linearLayout_marginTop"
            android:layout_width="match_parent"
            android:layout_height="@dimen/measure_plot_choose_line_text_height"
            android:orientation="horizontal">
            <TextView
                android:layout_width="@dimen/icon_width"
                android:layout_height="@dimen/icon_height"
                android:layout_marginStart="@dimen/icon_marginLeft"
                android:layout_marginTop="@dimen/icon_marginTop"
                android:background="@drawable/style_icon"/>
            <TextView
                android:layout_marginStart="@dimen/measure_text_marginLeft"
                android:layout_width="match_parent"
                android:layout_height="@dimen/measure_type_line_height"
                android:text="@string/measure_time"
                android:textStyle="bold"
                android:textSize="@dimen/measure_type_size"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/measure_plot_choose_line_marginTop"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:paddingVertical="8dp">
            <EditText
                android:id="@+id/textTimeBegin"
                android:layout_marginStart="@dimen/measure_plot_area_edit_marginLeft"
                android:background="@drawable/style_spinner_type"
                android:layout_width="@dimen/measure_plot_edit_width"
                android:layout_height="@dimen/measure_plot_edit_height"
                android:gravity="center"
                android:paddingBottom="@dimen/draw_area"
                android:paddingTop="@dimen/draw_area"
                android:hint="@string/start_time"
                android:textSize="@dimen/gridView_item_area_relative_obtain_text_size"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="@dimen/measure_plot_choose_line_text_height"
                android:text="@string/time_line"
                android:layout_gravity="center_vertical"
                android:textSize="@dimen/gridView_item_area_relative_obtain_text_size"
                android:layout_marginStart="@dimen/draw_area"/>
            <EditText
                android:id="@+id/textTimeEnd"
                android:layout_marginStart="@dimen/measure_plot_area_edit_input_marginLeft"
                android:background="@drawable/style_spinner_type"
                android:layout_width="@dimen/measure_plot_edit_width"
                android:layout_height="@dimen/measure_plot_edit_height"
                android:paddingBottom="@dimen/draw_area"
                android:paddingTop="@dimen/draw_area"
                android:gravity="center"
                android:hint="@string/end_time"
                android:textSize="@dimen/gridView_item_area_relative_obtain_text_size"/>
        </LinearLayout>
        <LinearLayout
            android:layout_marginTop="@dimen/spinner_linearLayout_marginTop"
            android:layout_width="match_parent"
            android:layout_height="@dimen/measure_plot_choose_line_text_height"
            android:orientation="horizontal">
            <TextView
                android:layout_width="@dimen/icon_width"
                android:layout_height="@dimen/icon_height"
                android:layout_marginStart="@dimen/icon_marginLeft"
                android:layout_marginTop="@dimen/icon_marginTop"
                android:background="@drawable/style_icon"/>
            <TextView
                android:layout_marginStart="@dimen/measure_text_marginLeft"
                android:layout_width="match_parent"
                android:layout_height="@dimen/measure_type_line_height"
                android:text="@string/measure_method"
                android:textStyle="bold"
                android:textSize="@dimen/measure_type_size"/>
        </LinearLayout>
        <RelativeLayout
            android:layout_marginTop="@dimen/measure_plot_choose_line_marginTop"
            android:layout_width="match_parent"
            android:layout_height="@dimen/measure_choose"
            android:orientation="horizontal"
            android:background="@color/white">
            <TextView
                android:layout_marginStart="@dimen/measure_plot_choose_line_text_marginLeft"
                android:layout_marginTop="@dimen/measure_plot_choose_line_text_marginTop"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/measure_plot_choose_line_text_height"
                android:textSize="@dimen/gridView_item_area_relative_obtain_text_size"
                android:textStyle="bold"
                android:text="@string/measure_method_text"/>
            <RelativeLayout
                android:id="@+id/rl_choose_method"
                android:layout_marginEnd="@dimen/measure_type_plot_choose"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="@dimen/measure_plot_choose_line_text_marginTop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:ignore="RelativeOverlap">
                <TextView
                    android:id="@+id/spinner_method"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/measure_info_re_height"
                    android:hint="@string/choose_method"
                    android:textSize="@dimen/gridView_item_area_relative_obtain_text_size"/>
                <ImageButton
                    style="?attr/materialIconButtonStyle"
                    android:id="@+id/btn_method"
                    android:layout_toEndOf="@id/spinner_method"
                    android:layout_width="@dimen/measure_enter_imageButton"
                    android:layout_height="@dimen/measure_enter_imageButton"
                    android:contentDescription="@string/choose_method"
                    android:src="@mipmap/enter"/>
            </RelativeLayout>
        </RelativeLayout>
        <LinearLayout
            android:layout_marginTop="@dimen/measure_button_marginTop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                style="?attr/materialIconButtonOutlinedStyle"
                android:id="@+id/buttonCancel"
                android:layout_marginStart="@dimen/size_drawerlayout_button_margin_left_right_cancel_confirm"
                app:strokeColor = "@color/grey_s"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/size_drawerlayout_button_height"
                android:textColor="@color/black"
                android:text="@string/buttonCancel"
                android:textSize="@dimen/Relative_second_relative_search_button_text_size"
                android:backgroundTint="@color/white"/>
            <Button
                style="?attr/materialIconButtonOutlinedStyle"
                android:id="@+id/buttonReset"
                app:strokeColor = "@color/grey_s"
                android:layout_marginStart="@dimen/size_drawerlayout_button_margin_left"
                 android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/size_drawerlayout_button_height"
                android:textColor="@color/black"
                android:text="@string/buttonReset"
                android:textSize="@dimen/Relative_second_relative_search_button_text_size"
                android:backgroundTint="@color/white" />
            <Button
                android:theme="@style/ThemeOverlay.App.Button"
                style="?attr/materialIconButtonFilledTonalStyle"
                android:id="@+id/buttonConfirm"
                android:textColor="@color/white"
                android:layout_marginStart="@dimen/size_drawerlayout_button_margin_left"
                android:layout_marginEnd="@dimen/size_drawerlayout_button_margin_left_right_cancel_confirm"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/size_drawerlayout_button_height"
                android:text="@string/buttonConfirm"
                android:textSize="@dimen/Relative_second_relative_search_button_text_size"/>
        </LinearLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>