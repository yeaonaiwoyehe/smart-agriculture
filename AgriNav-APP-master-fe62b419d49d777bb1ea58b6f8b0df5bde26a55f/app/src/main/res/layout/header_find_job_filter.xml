<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTint="#FFF3F7F7"
    android:orientation="vertical"
    android:scrollbarStyle="outsideOverlay">
    <LinearLayout
        android:id="@+id/find_job_sidebar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:padding="@dimen/font_find_job_padding"
        android:clickable="true"
        android:focusableInTouchMode="true">

        <!-- 任务名称输入 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/find_job_header_height_small"
            android:layout_marginTop="@dimen/font_find_job_margin"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="@dimen/find_job_detail_bar_width_small"
                    android:layout_height="@dimen/find_job_detail_bar_height_small"
                    android:layout_marginStart="@dimen/font_find_job_margin"
                    android:background="@drawable/style_find_farm_sider_icon"/>
                <TextView
                    android:layout_marginStart="@dimen/font_find_job_margin_start_max"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/find_job_header_height_small"
                    android:text="@string/find_job_select_task_name"
                    android:textStyle="bold"
                    android:textSize="@dimen/font_find_job_text_size_mid_small"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/find_job_header_height"
            android:layout_marginTop="@dimen/font_find_job_margin_top_max"
            android:layout_marginBottom="@dimen/font_find_job_margin"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/font_find_job_padding"
            android:background="@color/white"
            android:gravity="center">
            <TextView
                android:layout_width="@dimen/find_job_header_weight"
                android:layout_height="wrap_content"
                android:text="@string/find_job_select_name"
                android:textStyle="bold"
                android:textSize="@dimen/font_find_job_text_size_mid_small"
                android:layout_marginEnd="@dimen/font_find_job_margin"/>
            <EditText
                android:id="@+id/edt_find_job_name"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/find_job_select_item_height"
                android:background="@null"
                android:hint="@string/find_job_select_input_name"
                android:textSize="@dimen/font_find_job_text_size_small"
                android:gravity="center"
                android:padding="@dimen/font_find_job_padding_top"/>
        </LinearLayout>

        <!-- 农机类型选择 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/find_job_header_height_small"
            android:layout_marginTop="@dimen/font_find_job_margin"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="@dimen/find_job_detail_bar_width_small"
                    android:layout_height="@dimen/find_job_detail_bar_height_small"
                    android:layout_marginStart="@dimen/font_find_job_margin"
                    android:background="@drawable/style_find_farm_sider_icon"/>
                <TextView
                    android:layout_marginStart="@dimen/font_find_job_margin_start_max"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/find_job_header_height_small"
                    android:text="@string/find_job_machine_type"
                    android:textStyle="bold"
                    android:textSize="@dimen/font_find_job_text_size_mid_small"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 选择框 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/find_job_header_height"
            android:layout_marginTop="@dimen/font_find_job_margin_top_max"
            android:layout_marginBottom="@dimen/font_find_job_margin"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/font_find_job_padding"
            android:background="@color/white"
            android:gravity="center">
            <TextView
                android:layout_width="@dimen/find_job_header_weight"
                android:layout_height="wrap_content"
                android:text="@string/find_job_type"
                android:textStyle="bold"
                android:textSize="@dimen/font_find_job_text_size_mid_small"
                android:layout_marginEnd="@dimen/font_find_job_margin"/>
            <EditText
                android:id="@+id/edt_find_job_machine_type"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/find_job_select_item_height"
                android:background="@null"
                android:focusable="false"
                android:hint="@string/find_job_choose"
                android:textSize="@dimen/font_find_job_text_size_small"
                android:gravity="center"
                android:padding="@dimen/font_find_job_padding_top"/>
            <TextView
                android:id="@+id/tv_machine_type_tap"
                android:layout_width="@dimen/font_find_job_padding_max"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/find_job_arrows"
                android:textSize="@dimen/font_find_job_text_size_max"
                android:textStyle="bold"
                android:layout_marginStart="@dimen/font_find_job_margin_start_mid"/>
        </LinearLayout>

        <!-- 标签容器 -->
        <LinearLayout
            android:id="@+id/ll_machine_type_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingTop="@dimen/font_find_job_padding_top"
            android:paddingBottom="@dimen/font_find_job_padding_top"/>

        <!-- 作物类型选择 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/find_job_header_height_small"
            android:layout_marginTop="@dimen/font_find_job_margin"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="@dimen/find_job_detail_bar_width_small"
                    android:layout_height="@dimen/find_job_detail_bar_height_small"
                    android:layout_marginStart="@dimen/font_find_job_margin"
                    android:background="@drawable/style_find_farm_sider_icon" />
                <TextView
                    android:layout_marginStart="@dimen/font_find_job_margin_start_max"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/find_job_header_height_small"
                    android:text="@string/find_job_workable_crop"
                    android:textStyle="bold"
                    android:textSize="@dimen/font_find_job_text_size_mid_small"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/find_job_header_height"
            android:layout_marginTop="@dimen/font_find_job_margin_top_max"
            android:layout_marginBottom="@dimen/font_find_job_margin"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/font_find_job_padding"
            android:background="@color/white"
            android:gravity="center">
            <TextView
                android:layout_width="@dimen/find_job_header_weight"
                android:layout_height="wrap_content"
                android:text="@string/find_job_crop"
                android:textStyle="bold"
                android:textSize="@dimen/font_find_job_text_size_mid_small"
                android:layout_marginEnd="@dimen/font_find_job_margin"/>
            <EditText
                android:id="@+id/edt_workable_crops"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/find_job_select_item_height"
                android:background="@null"
                android:focusable="false"
                android:hint="@string/find_job_workable_crop_input"
                android:textSize="@dimen/font_find_job_text_size_small"
                android:gravity="center"
                android:padding="@dimen/font_find_job_padding_top"/>
            <TextView
                android:id="@+id/tv_workable_crops_tap"
                android:layout_width="@dimen/font_find_job_padding_max"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/find_job_arrows"
                android:textSize="@dimen/font_find_job_text_size_max"
                android:textStyle="bold"
                android:layout_marginStart="@dimen/font_find_job_margin_start_mid"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_workable_crops_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingTop="@dimen/font_find_job_padding_top"
            android:paddingBottom="@dimen/font_find_job_padding_top"/>

        <!-- 运粮车选择 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/find_job_header_height_small"
            android:layout_marginTop="@dimen/font_find_job_margin"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="@dimen/find_job_detail_bar_width_small"
                    android:layout_height="@dimen/find_job_detail_bar_height_small"
                    android:layout_marginStart="@dimen/font_find_job_margin"
                    android:background="@drawable/style_find_farm_sider_icon" />
                <TextView
                    android:layout_marginStart="@dimen/font_find_job_margin_start_max"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/find_job_header_height_small"
                    android:text="@string/find_job_having_transport"
                    android:textStyle="bold"
                    android:textSize="@dimen/font_find_job_text_size_mid_small"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/find_job_header_height"
            android:layout_marginTop="@dimen/font_find_job_margin_top_max"
            android:layout_marginBottom="@dimen/font_find_job_margin"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/font_find_job_padding"
            android:background="@color/white"
            android:gravity="center">
            <TextView
                android:layout_width="@dimen/find_job_header_weight"
                android:layout_height="wrap_content"
                android:text="@string/find_job_trans"
                android:textStyle="bold"
                android:textSize="@dimen/font_find_job_text_size_mid_small"
                android:layout_marginEnd="@dimen/font_find_job_margin"/>
            <EditText
                android:id="@+id/edt_grain_transport_vehicle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/find_job_select_item_height"
                android:background="@null"
                android:focusable="false"
                android:hint="@string/find_job_choose"
                android:textSize="@dimen/font_find_job_text_size_small"
                android:gravity="center"
                android:padding="@dimen/font_find_job_padding_top"/>
            <TextView
                android:id="@+id/tv_grain_transport_vehicle_tap"
                android:layout_width="@dimen/font_find_job_padding_max"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/find_job_arrows"
                android:textSize="@dimen/font_find_job_text_size_max"
                android:textStyle="bold"
                android:layout_marginStart="@dimen/font_find_job_margin_start_mid"/>
        </LinearLayout>

        <!-- 在运粮车选择框下方添加标签容器 -->
        <LinearLayout
            android:id="@+id/ll_grain_transport_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingTop="@dimen/font_find_job_padding_top"
            android:paddingBottom="@dimen/font_find_job_padding_top"/>

        <!-- 作业区域选择 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/find_job_header_height_small"
            android:layout_marginTop="@dimen/font_find_job_margin"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="@dimen/find_job_detail_bar_width_small"
                    android:layout_height="@dimen/find_job_detail_bar_height_small"
                    android:layout_marginStart="@dimen/font_find_job_margin"
                    android:background="@drawable/style_find_farm_sider_icon"/>
                <TextView
                    android:layout_marginStart="@dimen/font_find_job_margin_start_max"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/find_job_header_height_small"
                    android:text="@string/find_job_work_area"
                    android:textStyle="bold"
                    android:textSize="@dimen/font_find_job_text_size_mid_small"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/find_job_header_height"
            android:layout_marginTop="@dimen/font_find_job_margin_top_max"
            android:layout_marginBottom="@dimen/font_find_job_margin"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/font_find_job_padding"
            android:background="@color/white"
            android:gravity="center">
            <TextView
                android:layout_width="@dimen/find_job_header_weight"
                android:layout_height="wrap_content"
                android:text="@string/find_job_area"
                android:textStyle="bold"
                android:textSize="@dimen/font_find_job_text_size_mid_small"
                android:layout_marginEnd="@dimen/font_find_job_margin"/>
            <EditText
                android:id="@+id/edt_find_job_work_area"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/find_job_select_item_height"
                android:background="@null"
                android:focusable="false"
                android:hint="@string/find_job_work_area_input"
                android:textSize="@dimen/font_find_job_text_size_small"
                android:gravity="center"
                android:padding="@dimen/font_find_job_padding_top"/>
            <TextView
                android:id="@+id/tv_work_area_tap"
                android:layout_width="@dimen/font_find_job_padding_max"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/find_job_arrows"
                android:textSize="@dimen/font_find_job_text_size_max"
                android:textStyle="bold"
                android:layout_marginStart="@dimen/font_find_job_margin_start_mid"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_work_area_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingTop="@dimen/font_find_job_padding_top"
            android:paddingBottom="@dimen/font_find_job_padding_top"/>

        <!-- 底部按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/font_find_job_margin_max"
            android:layout_marginBottom="@dimen/font_find_job_margin_max">
            <Button
                android:id="@+id/btn_find_job_navigation_cancel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/find_job_select_cancel"
                style="?attr/materialButtonOutlinedStyle"/>
            <Button
                android:id="@+id/btn_find_job_navigation_reset"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/font_find_job_margin_start_mid"
                android:text="@string/find_job_select_reset"
                style="?attr/materialButtonOutlinedStyle"/>
            <Button
                android:id="@+id/btn_find_job_navigation_confirm"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/find_job_select_confirm"
                android:layout_marginStart="@dimen/font_find_job_margin_start_mid"/>
        </LinearLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>