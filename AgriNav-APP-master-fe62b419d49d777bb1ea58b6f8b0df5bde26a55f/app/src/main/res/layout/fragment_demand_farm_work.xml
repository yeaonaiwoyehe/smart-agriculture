<?xml version="1.0" encoding="utf-8"?>
<com.donkingliang.consecutivescroller.ConsecutiveScrollerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_marginTop="15dp"
            android:background="@drawable/style_condition"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:id="@+id/tv_condition_time2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:padding="4dp"
            android:paddingTop="0dp"
            android:text="@string/time"
            android:textColor="@color/front_text_edit"
            app:drawableRightCompat="@mipmap/row1"/>
    <HorizontalScrollView
        android:layout_marginTop="15dp"
        android:layout_centerVertical="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toStartOf="@id/tv_condition_time2">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tv_condition_plot_area"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/style_condition"
                android:layout_marginStart="17dp"
                android:layout_marginEnd="6dp"
                android:paddingEnd="4dp"
                android:paddingStart="4dp"
                android:paddingBottom="4dp"
                android:text="@string/plot_mu"
                android:textColor="@color/front_text_edit"
                app:drawableRightCompat="@mipmap/under"/>
            <TextView
                android:id="@+id/tv_condition_work_area"
                android:background="@drawable/style_condition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:padding="4dp"
                android:paddingTop="0dp"
                android:text="@string/work_area"
                android:textColor="@color/front_text_edit"
                app:drawableRightCompat="@mipmap/under"/>
            <TextView
                android:id="@+id/tv_condition_crop"
                android:background="@drawable/style_condition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:padding="4dp"
                android:paddingTop="0dp"
                android:text="@string/crops"
                android:textColor="@color/front_text_edit"
                app:drawableRightCompat="@mipmap/under"/>
            <TextView
                android:id="@+id/tv_condition_work_type"
                android:background="@drawable/style_condition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:padding="4dp"
                android:paddingTop="0dp"
                android:text="@string/work_type"
                android:textColor="@color/front_text_edit"
                app:drawableRightCompat="@mipmap/under"/>

            <TextView
                android:id="@+id/tv_condition_deadline"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:background="@drawable/style_condition"
                android:padding="4dp"
                android:paddingTop="0dp"
                android:text="@string/deadline"
                android:textColor="@color/front_text_edit"
                app:drawableRightCompat="@mipmap/under" />
        </LinearLayout>
    </HorizontalScrollView>
    </RelativeLayout>
    <GridView 
        android:id="@+id/grid_demand_farm_work" 
        android:layout_width="match_parent" 
        android:layout_height="match_parent" 
        android:layout_marginLeft="@dimen/gridView_item_margin" 
        android:layout_marginRight="@dimen/gridView_item_margin" 
        android:layout_marginTop="@dimen/gridView_first_line_item_marginTop" 
        android:horizontalSpacing="@dimen/gridView_item_space" 
        android:verticalSpacing="@dimen/gridView_item_space" 
        android:numColumns="@integer/gridView_numColumn" />
</com.donkingliang.consecutivescroller.ConsecutiveScrollerLayout>