<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout_trajectory"
    android:fitsSystemWindows="true">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_trajectory"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:background="@color/green_final"
            app:titleCentered="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/trajectory"
                android:textColor="@color/white"
                android:layout_gravity="center"
                android:textSize="18sp"/>
        </com.google.android.material.appbar.MaterialToolbar>
        <LinearLayout
            android:layout_below="@id/toolbar_trajectory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="@integer/trajectory_weight_small">
                <ImageView
                    android:id="@+id/tv_begin_work"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:src="@mipmap/work"
                    android:layout_toStartOf="@id/ll_switch_choose_view"
                    android:layout_marginEnd="20dp"
                    android:padding="10dp"/>
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/ll_switch_choose_view"
                    android:layout_width="@dimen/trajectory_btn_group_width"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    app:singleSelection="true">
                    <Button
                        android:id="@+id/buttonLeft"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/trajectory_btn_text_work"
                        android:textSize="@dimen/trajectory_btn_group_text_size"
                        android:backgroundTint="@color/green_final"
                        />
                    <Button
                        android:id="@+id/buttonRight"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/trajectory_btn_text_origin"
                        android:textSize="@dimen/trajectory_btn_group_text_size"
                        android:backgroundTint="@color/green_final"
                        />
                </com.google.android.material.button.MaterialButtonToggleGroup>
                <LinearLayout
                    android:id="@+id/ll_trajectory_sort"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/ll_switch_choose_view"
                    android:layout_marginStart="20dp">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:src="@mipmap/sort"/>
<!--                    <TextView-->
<!--                        android:layout_width="wrap_content"-->
<!--                        android:layout_height="wrap_content"-->
<!--                        android:text="@string/trajectory_tv_sort"-->
<!--                        android:textSize="@dimen/trajectory_btn_group_text_size"/>-->
                </LinearLayout>

            </RelativeLayout>
<!--            下面是下面的内容-->
            <FrameLayout
                android:id="@+id/vp_trajectory"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="@integer/trajectory_weight_big"
                android:paddingHorizontal="@dimen/trajectory_font_item_padding_small"
                android:paddingTop="@dimen/trajectory_font_item_padding"
                android:background="@color/grey_background"/>
        </LinearLayout>
    </RelativeLayout>
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_trajectory_select"
        android:layout_width="wrap_content"
        app:headerLayout="@layout/navigation_trajectory_select"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        />
<!--    可以添加这个作为扩展app:menu="@menu/menu_trajectory_navigation"-->

</androidx.drawerlayout.widget.DrawerLayout>