<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTint="#FFF3F7F7"
    android:orientation="vertical"
    android:scrollbarStyle="outsideOverlay">
    <LinearLayout
        android:id="@+id/find_farm_sidebar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:padding="10dp"
        android:clickable="true"
        android:focusableInTouchMode="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:layout_marginTop="10dp"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="5dp"
                    android:layout_height="15dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/style_find_farm_sider_icon"/>
                <TextView
                    android:layout_marginStart="13dp"
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:text="按亩数大小筛选"
                    android:textStyle="bold"
                    android:textSize="16sp"/>
            </LinearLayout>
        </LinearLayout>
        <RelativeLayout
            android:id="@+id/ll_find_farm_size_side"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:background="@color/white">
            <TextView
                android:id="@+id/tv_from_character"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_centerVertical="true"
                android:text="从"
                android:textSize="14sp"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/edt_find_farm_size_from"
                android:layout_height="30dp"
                android:layout_width="110dp"
                android:layout_margin="5dp"
                android:gravity="center"
                android:layout_centerVertical="true"
                android:hint="最小值"
                android:inputType="number"
                android:background="@drawable/style_find_farm_spinner"
                android:textSize="14sp"
                android:layout_toRightOf="@+id/tv_from_character" />
            <TextView
                android:id="@+id/tv_to_character"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_centerVertical="true"
                android:text="至"
                android:textSize="14sp"
                android:layout_toRightOf="@+id/edt_find_farm_size_from"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/edt_find_farm_size_to"
                android:layout_height="30dp"
                android:layout_width="110dp"
                android:layout_margin="5dp"
                android:background="@drawable/style_find_farm_spinner"
                android:gravity="center"
                android:layout_centerVertical="true"
                android:inputType="number"
                android:hint="最大值"
                android:textSize="14sp"
                android:layout_toRightOf="@+id/tv_to_character" />
        </RelativeLayout>
        <!--第三行 按地块选择-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:layout_marginTop="10dp"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="5dp"
                    android:layout_height="15dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/style_find_farm_sider_icon"/>
                <TextView
                    android:layout_marginStart="13dp"
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:text="按地块筛选"
                    android:textStyle="bold"
                    android:textSize="16sp"/>
            </LinearLayout>
        </LinearLayout>
        <!--第四行 作物筛选-->
        <LinearLayout
            android:id="@+id/ll_find_farm_land_side"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:background="@color/white">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:text="地块"
                android:textSize="14sp"
                android:textStyle="bold" />
            <RelativeLayout
                android:id="@+id/rl_find_farm_chosen_land"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3">
                <EditText
                    android:id="@+id/tv_find_farm_item_land"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_centerInParent="true"
                    android:layout_toLeftOf="@+id/tv_select_land_tap"
                    android:background="@null"
                    android:focusable="false"
                    android:hint="选择地块"
                    android:textSize="14sp"
                    android:minHeight="30dp"
                    android:paddingVertical="5dp"
                    android:cursorVisible="false" />
                <TextView
                    android:id="@+id/tv_select_land_tap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:padding="7dp"
                    android:text=">"
                    android:textSize="20dp"
                    android:textStyle="bold"
                    android:layout_marginEnd="10dp" />
            </RelativeLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ll_land_select_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"/>
        <!--第五行 按作物选择-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:layout_marginTop="10dp"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="5dp"
                    android:layout_height="15dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/style_find_farm_sider_icon"/>
                <TextView
                    android:layout_marginStart="13dp"
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:text="按作物筛选"
                    android:textStyle="bold"
                    android:textSize="16sp"/>
            </LinearLayout>
        </LinearLayout>
        <!--第六行 作物筛选-->
        <LinearLayout
            android:id="@+id/ll_find_farm_crop_side"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:background="@color/white">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:text="作物"
                android:textSize="14sp"
                android:textStyle="bold" />
            <RelativeLayout
                android:id="@+id/rl_find_farm_chosen_corn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3">
                <EditText
                    android:id="@+id/tv_find_farm_item_corn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_centerInParent="true"
                    android:layout_toLeftOf="@+id/tv_select_crop_tap"
                    android:background="@null"
                    android:focusable="false"
                    android:cursorVisible="false"
                    android:hint="选择作物"
                    android:minHeight="30dp"
                    android:paddingVertical="5dp"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/tv_select_crop_tap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:padding="7dp"
                    android:text=">"
                    android:textSize="20dp"
                    android:textStyle="bold"
                    android:layout_marginEnd="10dp" />
            </RelativeLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ll_crop_select_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"/>
        <!--第七行 按作业类型选择-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:layout_marginTop="10dp"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="5dp"
                    android:layout_height="15dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/style_find_farm_sider_icon"/>

                <TextView
                    android:layout_marginStart="13dp"
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:text="按作业类型筛选"
                    android:textStyle="bold"
                    android:textSize="16sp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ll_crop_selection_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"/>
        <!--第八行 作业类型筛选-->
        <LinearLayout
            android:id="@+id/ll_find_farm_operation_side"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:background="@color/white">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:text="作业类型"
                android:textSize="14sp"
                android:textStyle="bold" />
            <RelativeLayout
                android:id="@+id/rl_find_farm_chosen_operation"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3">
                <EditText
                    android:id="@+id/tv_find_farm_item_operation"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:layout_centerInParent="true"
                    android:layout_toLeftOf="@+id/tv_select_operation_tap"
                    android:background="@null"
                    android:focusable="false"
                    android:cursorVisible="false"
                    android:hint="选择作业类型"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/tv_select_operation_tap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:padding="7dp"
                    android:text=">"
                    android:textSize="20dp"
                    android:textStyle="bold"
                    android:layout_marginEnd="10dp" />
            </RelativeLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ll_operation_selection_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"/>

