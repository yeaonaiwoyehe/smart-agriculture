<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/person_header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/personal_height_header"
        android:background="@mipmap/bg_person">

        <LinearLayout
            android:id="@+id/person_info"
            android:layout_width="match_parent"
            android:layout_height="@dimen/personal_height_header_image"
            android:layout_marginTop="@dimen/personal_margin_info_top"
            android:layout_marginLeft="@dimen/personal_margin_around_max"
            android:layout_marginRight="@dimen/personal_margin_around_max"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_person_avatar"
                android:layout_width="@dimen/personal_size_image"
                android:layout_height="@dimen/personal_size_image" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/personal_size_info"
                android:gravity="center_vertical"
                android:layout_marginStart="@dimen/personal_margin_around_mid"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_person_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/personal_size_text_max"
                    android:fontFamily="@font/ping_fang"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_person_phone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/personal_height_info"
                    android:textSize="@dimen/personal_size_text_small"
                    android:fontFamily="@font/ping_fang"
                    android:textColor="@color/white"/>
            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>

    <LinearLayout
        android:id="@+id/person_items"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="@dimen/personal_items_margin_top">

        <LinearLayout
            android:id="@+id/person_company"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/personal_item_height"
                android:layout_marginLeft="@dimen/personal_margin_around_max"
                android:layout_marginRight="@dimen/personal_margin_around_max">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/personal_items_image_height"
                        android:src="@mipmap/company" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_person_company"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/personal_item_height"
                    android:layout_weight="5"
                    android:gravity="center_vertical"
                    android:fontFamily="@font/ping_fang"
                    android:textColor="@color/black"
                    android:textSize="@dimen/personal_size_text_mid" />

            </LinearLayout>

        </LinearLayout>

        <View
            android:id="@+id/view_line"
            android:layout_width="match_parent"
            android:layout_height="@dimen/login_finger_bottom_division_small"
            android:background="@color/grey" />

        <LinearLayout
            android:id="@+id/person_communication"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/personal_item_height"
                android:layout_marginLeft="@dimen/personal_margin_around_max"
                android:layout_marginRight="@dimen/personal_margin_around_max">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/personal_items_image_height"
                        android:src="@mipmap/communication" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_person_communication"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/personal_item_height"
                    android:layout_weight="5"
                    android:gravity="center_vertical"
                    android:text="@string/personal_communication"
                    android:fontFamily="@font/ping_fang"
                    android:textColor="@color/black"
                    android:textSize="@dimen/personal_size_text_mid" />

            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/personal_margin_around_small"
            android:background="@color/grey" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/white">

            <LinearLayout
                android:id="@+id/person_security"
                android:layout_width="match_parent"
                android:layout_height="@dimen/personal_item_height"
                android:layout_marginLeft="@dimen/personal_margin_around_max"
                android:layout_marginRight="@dimen/personal_margin_around_max">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/personal_items_image_height"
                        android:src="@mipmap/security" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_person_security"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/personal_item_height"
                    android:layout_weight="5"
                    android:gravity="center_vertical"
                    android:text="@string/personal_security"
                    android:fontFamily="@font/ping_fang"
                    android:textColor="@color/black"
                    android:textSize="@dimen/personal_size_text_mid" />

            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/personal_margin_around_small"
            android:background="@color/grey" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/white">

            <LinearLayout
                android:id="@+id/person_commit"
                android:layout_width="match_parent"
                android:layout_height="@dimen/personal_item_height"
                android:layout_marginLeft="@dimen/personal_margin_around_max"
                android:layout_marginRight="@dimen/personal_margin_around_max">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/personal_items_image_height"
                        android:src="@mipmap/land" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_person_commit"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/personal_item_height"
                    android:layout_weight="5"
                    android:gravity="center_vertical"
                    android:text="@string/personal_commit"
                    android:fontFamily="@font/ping_fang"
                    android:textColor="@color/black"
                    android:textSize="@dimen/personal_size_text_mid" />

            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/personal_margin_around_small"
            android:background="@color/grey" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/white">

            <LinearLayout
                android:id="@+id/person_suggestion"
                android:layout_width="match_parent"
                android:layout_height="@dimen/personal_item_height"
                android:layout_marginLeft="@dimen/personal_margin_around_max"
                android:layout_marginRight="@dimen/personal_margin_around_max">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/personal_items_image_height"
                        android:src="@mipmap/suggestion" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_person_suggestion"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/personal_item_height"
                    android:layout_weight="5"
                    android:gravity="center_vertical"
                    android:text="@string/personal_feedback"
                    android:fontFamily="@font/ping_fang"
                    android:textColor="@color/black"
                    android:textSize="@dimen/personal_size_text_mid" />

            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/personal_margin_around_small"
            android:background="@color/grey" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/white">

            <LinearLayout
                android:id="@+id/person_privacy"
                android:layout_width="match_parent"
                android:layout_height="@dimen/personal_item_height"
                android:layout_marginLeft="@dimen/personal_margin_around_max"
                android:layout_marginRight="@dimen/personal_margin_around_max">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/personal_items_image_height"
                        android:src="@mipmap/privacy" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_person_privacy"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/personal_item_height"
                    android:layout_weight="5"
                    android:gravity="center_vertical"
                    android:text="@string/personal_privacy"
                    android:fontFamily="@font/ping_fang"
                    android:textColor="@color/black"
                    android:textSize="@dimen/personal_size_text_mid" />

            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/personal_margin_around_small"
            android:background="@color/grey" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/white">

            <LinearLayout
                android:id="@+id/person_version"
                android:layout_width="match_parent"
                android:layout_height="@dimen/personal_item_height"
                android:layout_marginLeft="@dimen/personal_margin_around_max"
                android:layout_marginRight="@dimen/personal_margin_around_max">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/personal_items_image_height"
                        android:src="@mipmap/version" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_person_version"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/personal_item_height"
                    android:layout_weight="5"
                    android:gravity="center_vertical"
                    android:text="@string/personal_version"
                    android:fontFamily="@font/ping_fang"
                    android:textColor="@color/black"
                    android:textSize="@dimen/personal_size_text_mid" />

            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/personal_margin_around_small"
            android:background="@color/grey" />

    </LinearLayout>

    <LinearLayout
        android:layout_below="@+id/person_items"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_person_exit"
            android:layout_width="@dimen/personal_button_width"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/personal_button_margin"
            android:text="@string/personal_logout"
            android:fontFamily="@font/ping_fang"
            android:textColor="@color/white"
            android:textSize="@dimen/personal_size_text_mid" />

    </LinearLayout>

</RelativeLayout>