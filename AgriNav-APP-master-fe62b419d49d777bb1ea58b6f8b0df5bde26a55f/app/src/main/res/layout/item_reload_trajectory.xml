<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_marginHorizontal="@dimen/margin_component_tiny"
    android:layout_height="wrap_content"
    android:background="@drawable/trajectory_style_no_border_radius">
    <LinearLayout
        android:layout_weight="@integer/trajectory_weight_mid_s"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:layout_marginVertical="@dimen/margin_component_tiny"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:background="@drawable/trajectory_style_text"
                android:textStyle="bold"
                android:text="@string/reload_text_time_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/reload_text_size_mid"
                android:layout_marginEnd="@dimen/margin_component_tiny"/>
            <TextView
                android:id="@+id/reload_time_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/reload_text_size_small"/>
        </LinearLayout>
        <LinearLayout
            android:layout_marginBottom="@dimen/margin_component_tiny"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:background="@drawable/trajectory_style_text"
                android:textStyle="bold"
                android:text="@string/reload_text_time_end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/reload_text_size_mid"
                android:layout_marginEnd="@dimen/margin_component_tiny"/>
            <TextView
                android:id="@+id/reload_time_end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/reload_text_size_small"/>
        </LinearLayout>
        <LinearLayout
            android:layout_marginBottom="@dimen/margin_component_tiny"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:background="@drawable/trajectory_style_text"
                android:textStyle="bold"
                android:text="@string/reload_text_work_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/reload_text_size_mid"
                android:layout_marginEnd="@dimen/margin_component_tiny"/>
            <TextView
                android:id="@+id/reload_time_work_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/reload_text_size_small"/>
        </LinearLayout>

    </LinearLayout>
    <Button
        android:id="@+id/btn_reload"
        android:layout_gravity="center"
        android:textSize="@dimen/reload_text_size_small"
        android:layout_weight="@integer/trajectory_weight_small"
        android:layout_width="0dp"
        android:layout_height="wrap_content">
    </Button>
</LinearLayout>