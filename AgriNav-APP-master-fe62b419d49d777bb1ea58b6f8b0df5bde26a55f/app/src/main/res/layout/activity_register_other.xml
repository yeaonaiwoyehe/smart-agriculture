<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@mipmap/bg">
    </LinearLayout>
    <TextView
        android:id="@+id/tv_register_other_phone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/register_other_text"
        android:textStyle="bold"
        android:fontFamily="@font/ping_fang"
        android:textSize="@dimen/login_register_text_size"
        android:layout_above="@id/tv_register_other_welcome"
        android:layout_alignStart="@id/ll_register_other_center"
        android:layout_marginBottom="@dimen/login_register_text_view_string_margin_small"/>
    <TextView
        android:id="@+id/tv_register_other_welcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/register_other_welcome"
        android:layout_above="@id/ll_register_other_center"
        android:textSize="@dimen/login_register_text_view_string_size"
        android:fontFamily="@font/ping_fang"
        android:layout_marginBottom="@dimen/login_register_text_view_string_margin_big"
        android:textColor="@color/grey_s"
        android:layout_alignStart="@+id/ll_register_other_center"/>
    <LinearLayout
        android:id="@+id/ll_register_other_center"
        android:layout_width="@dimen/login_register_btn_width"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical">
        <EditText
            android:id="@+id/edt_register_other"
            android:layout_width="@dimen/login_register_edt_width"
            android:layout_height="wrap_content"
            android:inputType="phone"
            android:paddingTop="@dimen/page_padding"
            android:fontFamily="@font/ping_fang"
            android:hint="@string/register_other_edt_content"
            android:textSize="@dimen/login_register_edt_text_size" />
        <Button
            android:id="@+id/btn_register_other_ok"
            android:layout_width="@dimen/login_register_edt_width"
            android:layout_height="wrap_content"
            android:text="@string/register_other_btn_ok"
            android:textSize="@dimen/login_register_btn_text_size"
            android:fontFamily="@font/ping_fang"
            android:backgroundTint="@color/green"
            android:layout_marginVertical="@dimen/login_register_btn_margin_vertical"/>
    </LinearLayout>
    <LinearLayout
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/ll_register_other_center">
        <CheckBox
            android:id="@+id/rb_register_other_protocol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/protocol_ok"
            android:fontFamily="@font/ping_fang"
            android:button="@drawable/icon_protocol_selector"
            android:paddingStart="@dimen/protocol_margin_or_padding"
            android:textSize="@dimen/protocol_text_size"
            tools:ignore="RtlSymmetry" />
        <TextView
            android:id="@+id/tv_register_other_read_protocol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/protocol_see"
            android:fontFamily="@font/ping_fang"
            android:textSize="@dimen/protocol_text_size"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tv_register_other_read_protocol_personal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/protocol_personal_see"
            android:fontFamily="@font/ping_fang"
            android:textSize="@dimen/protocol_text_size"
            android:textStyle="bold" />
    </LinearLayout>
</RelativeLayout>