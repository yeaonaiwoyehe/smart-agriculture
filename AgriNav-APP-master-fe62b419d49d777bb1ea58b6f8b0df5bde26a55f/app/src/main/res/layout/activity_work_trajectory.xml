<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".trajectory.activity.WorkTrajectoryActivity">
    <androidx.camera.view.PreviewView
        android:id="@+id/trajectory_work_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible"/>
    <LinearLayout
        android:id="@+id/snack_bar_container_work"
        android:layout_marginTop="100dp"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:orientation="horizontal"
        android:visibility="invisible">
    </LinearLayout>
    <com.amap.api.maps.MapView
        android:id="@+id/map_work"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_trajectory_work_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:icon="@mipmap/btn_icon_end"
        android:text="@string/trajectory_work_btn_text_content"
        android:textSize="@dimen/trajectory_work_btn_text_size"
        android:fontFamily="@font/ping_fang"
        android:layout_marginBottom="@dimen/trajectory_work_btn_margin_small"
        android:layout_marginEnd="@dimen/trajectory_work_btn_margin_big"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_trajectory_work_take_photo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:icon="@mipmap/camera"
        android:text="@string/trajectory_work_btn_text_take_photo"
        android:textSize="@dimen/trajectory_work_btn_text_size"
        android:fontFamily="@font/ping_fang"
        android:layout_marginBottom="@dimen/trajectory_work_btn_margin_small"
        android:layout_marginStart="@dimen/trajectory_work_btn_margin_big"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        />

</RelativeLayout>