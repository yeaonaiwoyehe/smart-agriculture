<?xml version="1.0" encoding="utf-8"?>
<com.donkingliang.consecutivescroller.ConsecutiveScrollerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="vertical">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_marginTop="15dp"
            android:background="@drawable/style_condition"
            android:id="@+id/tv_condition_time1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="6dp"
            android:padding="4dp"
            android:paddingTop="0dp"
            android:text="@string/time"
            android:textColor="@color/front_text_edit"
            app:drawableRightCompat="@mipmap/row1"/>
   <HorizontalScrollView
       android:layout_marginTop="15dp"
       android:layout_centerVertical="true"
       android:layout_toStartOf="@id/tv_condition_time1"
       android:layout_width="match_parent"
       android:layout_height="wrap_content">
       <LinearLayout
           android:layout_width="wrap_content"
           android:layout_height="match_parent"
           android:orientation="horizontal">
           <TextView
               android:id="@+id/tv_condition_model"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_marginStart="17dp"
               android:layout_marginEnd="6dp"
               android:background="@drawable/style_condition"
               android:padding="4dp"
               android:paddingTop="0dp"
               android:textColor="@color/front_text_edit"
               android:text="@string/agricultural_machinery_model"
               app:drawableRightCompat="@mipmap/under"/>
           <TextView
               android:id="@+id/tv_condition_can_area"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_marginEnd="6dp"
               android:background="@drawable/style_condition"
               android:padding="4dp"
               android:paddingTop="0dp"
               android:text="@string/operable_area"
               android:textColor="@color/front_text_edit"
               app:drawableRightCompat="@mipmap/under"/>
           <TextView
               android:id="@+id/tv_condition_crops"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_marginEnd="6dp"
               android:background="@drawable/style_condition"
               android:padding="4dp"
               android:paddingTop="0dp"
               android:text="@string/operable_crops"
               android:textColor="@color/front_text_edit"
               app:drawableRightCompat="@mipmap/under"/>
           <TextView
               android:id="@+id/tv_condition_grain_truck"
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:layout_marginEnd="6dp"
               android:background="@drawable/style_condition"
               android:padding="4dp"
               android:paddingTop="0dp"
               android:textColor="@color/front_text_edit"
               android:text="@string/equipped_grain_truck"/>
       </LinearLayout>
   </HorizontalScrollView>
    </RelativeLayout>
    <GridView
        android:id="@+id/grid_machinery"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/gridView_item_margin"
        android:layout_marginRight="@dimen/gridView_item_margin"
        android:horizontalSpacing="@dimen/gridView_item_space"
        android:verticalSpacing="@dimen/gridView_item_space"
        android:numColumns="@integer/gridView_numColumn" />
</com.donkingliang.consecutivescroller.ConsecutiveScrollerLayout>