<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".trajectory.activity.TrajectoryActivity"
    android:fitsSystemWindows="true">
    <com.amap.api.maps.MapView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="@integer/trajectory_weight_mid_b"
        android:id="@+id/map_trajectory"/>
    <LinearLayout
        android:id="@+id/ll_trajectory_begin_bottom"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:layout_weight="@integer/trajectory_weight_mid_b"
        android:background="@drawable/style_bottom_sheet_big"
        android:padding="@dimen/trajectory_font_item_padding">
        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_height="0dp"
            android:layout_weight="@integer/trajectory_weight_small"
            android:background="@drawable/trajectory_style_no_border_radius"
            android:layout_margin="@dimen/margin_component_tiny">
            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/navigation_item_text_corn"
                android:gravity="center"
                android:textSize="@dimen/trajectory_fragment_text_small"
                android:layout_weight="@integer/trajectory_weight_mid_s"
                android:textStyle="bold"/>
            <RelativeLayout
                android:id="@+id/rl_trajectory_begin_corn"
                android:layout_weight="@integer/trajectory_weight_mid_b"
                android:layout_width="0dp"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_marginEnd="@dimen/margin_component_small"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/trajectory_icon_menu"/>
                <TextView
                    android:id="@+id/tv_trajectory_begin_corn"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:textSize="@dimen/trajectory_fragment_text_small"
                    android:hint="@string/navigation_item_hint_corn"/>
            </RelativeLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_height="0dp"
            android:layout_weight="@integer/trajectory_weight_small"
            android:background="@drawable/trajectory_style_no_border_radius"
            android:layout_margin="@dimen/margin_component_tiny">
            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/navigation_item_text_corn_type"
                android:gravity="center"
                android:textSize="@dimen/trajectory_fragment_text_small"
                android:layout_weight="@integer/trajectory_weight_mid_s"
                android:textStyle="bold"/>
            <RelativeLayout
                android:id="@+id/rl_trajectory_begin_corn_type"
                android:layout_weight="@integer/trajectory_weight_mid_b"
                android:layout_width="0dp"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_marginEnd="@dimen/margin_component_small"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/trajectory_icon_menu"/>
                <TextView
                    android:layout_gravity="center"
                    android:id="@+id/tv_trajectory_begin_corn_type"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:textSize="@dimen/trajectory_fragment_text_small"
                    android:hint="@string/navigation_item_hint_corn_type"/>
            </RelativeLayout>

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_height="0dp"
            android:layout_weight="@integer/trajectory_weight_small"
            android:background="@drawable/trajectory_style_no_border_radius"
            android:layout_margin="@dimen/margin_component_tiny">
            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/navigation_item_text_state"
                android:gravity="center"
                android:textSize="@dimen/trajectory_fragment_text_small"
                android:layout_weight="@integer/trajectory_weight_mid_s"
                android:textStyle="bold"/>
            <TextView
                android:gravity="center_vertical"
                android:layout_gravity="center"
                android:id="@+id/tv_trajectory_begin_state"
                android:layout_weight="@integer/trajectory_weight_mid_b"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:textSize="@dimen/trajectory_fragment_text_small"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_height="0dp"
            android:layout_weight="@integer/trajectory_weight_small"
            android:background="@drawable/trajectory_style_no_border_radius"
            android:layout_margin="@dimen/margin_component_tiny">
            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/navigation_item_text_width"
                android:gravity="center"
                android:textSize="@dimen/trajectory_fragment_text_small"
                android:layout_weight="@integer/trajectory_weight_mid_s"
                android:textStyle="bold"/>
            <EditText
                android:id="@+id/tv_trajectory_begin_width"
                android:layout_weight="@integer/trajectory_weight_mid_b"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:textSize="@dimen/trajectory_fragment_text_small"
                android:background="@null"
                android:gravity="center_vertical"
                android:hint="@string/navigation_item_hint_width"
                android:inputType="number"/>
        </LinearLayout>
        <Button
            android:layout_gravity="center"
            android:id="@+id/btn_trajectory_begin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/trajectory_begin"
            android:paddingHorizontal="@dimen/page_padding"
            android:textSize="@dimen/trajectory_fragment_text_small"/>

    </LinearLayout>
</LinearLayout>