<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gridView_white"
    android:orientation="vertical">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.1"
        android:background="@color/white">
        <ImageButton
            style="?attr/materialIconButtonStyle"
            android:contentDescription="@string/back"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/back_button_marginLeft"
            android:id="@+id/buttonBack"
            android:src="@mipmap/back"
            android:layout_width="@dimen/ImageButton_back_width"
            android:layout_height="@dimen/ImageButton_back_height"/>
        <TextView
            android:layout_alignParentBottom="true"
            android:layout_width="@dimen/measure_write_info_text_width"
            android:layout_height="@dimen/measure_write_info_text_height"
            android:text="@string/measure_write_info"
            android:textStyle="bold"
            android:textSize="@dimen/measure_write_info_text_size"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <LinearLayout
        android:id="@+id/linearLayout_top"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.4"
        android:orientation="vertical">
       <LinearLayout
           android:layout_width="match_parent"
           android:layout_height="0dp"
           android:layout_weight="0.05">
           <RelativeLayout
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:id="@+id/info_text_relative">
               <RelativeLayout
                   android:layout_width="match_parent"
                   android:layout_height="match_parent">
                   <TextView
                       android:layout_marginStart="@dimen/plotInfo_margin_one_five"
                       android:layout_centerVertical="true"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:background="@drawable/style_icon_bigger"
                       tools:ignore="RelativeOverlap" />
                   <TextView
                       android:layout_centerVertical="true"
                       android:layout_marginStart="@dimen/plotInfo_margin_three"
                       android:layout_marginEnd="@dimen/plotInfo_margin"
                       android:id="@+id/tv_plotLocationInfoText"
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:text="@string/plotLocationInfo"
                       android:textStyle="bold"
                       android:textSize="@dimen/measure_info_text_size"/>
                   <ImageButton
                       android:layout_centerVertical="true"
                       style="?attr/materialIconButtonStyle"
                       android:contentDescription="@string/location"
                       android:id="@+id/ImageButtonLocation"
                       android:layout_marginEnd="@dimen/measure_location_icon_marginRight"
                       android:layout_alignParentEnd="true"
                       android:src="@mipmap/location"
                       android:layout_width="@dimen/measure_location_size"
                       android:layout_height="@dimen/measure_location_size"/>
               </RelativeLayout>
               </RelativeLayout>
       </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.3"
            android:layout_marginStart="@dimen/plotInfo_margin_one_five"
            android:layout_marginEnd="@dimen/plotInfo_margin_one_five"
            android:background="@color/white"
            android:orientation="vertical">
            <RelativeLayout
                android:id="@+id/province"
                android:background="@drawable/style_info"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <TextView
                    android:layout_marginStart="@dimen/plotInfo_margin_one_five"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/plotInfo_margin"
                    android:textSize="@dimen/plotInfoSize"
                    android:id="@+id/tv_yourLocation"
                    android:text="@string/yourProvince"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <RelativeLayout
                    android:id="@+id/rl_province"
                    android:layout_centerVertical="true"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/measure_info_re_height"
                    android:layout_marginEnd="@dimen/plotInfo_margin_one_five"
                    android:layout_alignParentEnd="true"
                    tools:ignore="RelativeOverlap">
                    <TextView
                        android:layout_centerVertical="true"
                        android:completionThreshold="1"
                        android:autofillHints="location"
                        android:inputType="textPostalAddress"
                        android:id="@+id/editProvince"
                        android:background="@null"
                        android:hint="@string/infoProvince_hint"
                        android:textSize="@dimen/address_edit_text_size"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:ignore="TextViewEdits" />
                    <ImageButton
                        android:layout_centerVertical="true"
                        android:id="@+id/imageButtonProvince"
                        style="?attr/materialIconButtonStyle"
                        android:layout_marginStart="5dp"
                        android:layout_toEndOf="@+id/editProvince"
                        android:layout_width="@dimen/measure_enter_imageButton"
                        android:layout_height="@dimen/measure_enter_imageButton"
                        android:contentDescription="@string/hint_enter"
                        android:src="@mipmap/enter"/>
                </RelativeLayout>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/city"
                android:background="@drawable/style_info"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <TextView
                    android:layout_marginStart="@dimen/plotInfo_margin_one_five"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/plotInfo_margin"
                    android:textSize="@dimen/plotInfoSize"
                    android:id="@+id/tv_yourLocationCity"
                    android:text="@string/yourCity"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <RelativeLayout
                    android:id="@+id/rl_city"
                    android:layout_centerVertical="true"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/measure_info_re_height"
                    android:layout_marginEnd="@dimen/plotInfo_margin_one_five"
                    android:layout_alignParentEnd="true"
                    tools:ignore="RelativeOverlap">
                    <TextView
                        android:layout_centerVertical="true"
                        android:autofillHints="location"
                        android:inputType="textPostalAddress"
                        android:id="@+id/editCity"
                        android:background="@null"
                        android:hint="@string/infoCity_hint"
                        android:textSize="@dimen/address_edit_text_size"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:ignore="TextViewEdits" />
                    <ImageButton
                        android:layout_centerVertical="true"
                        android:id="@+id/imageButtonCity"
                        style="?attr/materialIconButtonStyle"
                        android:layout_marginStart="5dp"
                        android:layout_toEndOf="@+id/editCity"
                        android:layout_width="@dimen/measure_enter_imageButton"
                        android:layout_height="@dimen/measure_enter_imageButton"
                        android:contentDescription="@string/hint_enter"
                        android:src="@mipmap/enter"/>
                </RelativeLayout>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/district"
                android:background="@drawable/style_info"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <TextView
                    android:layout_marginStart="@dimen/plotInfo_margin_one_five"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/plotInfo_margin"
                    android:textSize="@dimen/plotInfoSize"
                    android:id="@+id/tv_yourDistrict"
                    android:text="@string/yourDistrict"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <RelativeLayout
                    android:id="@+id/rl_district"
                    android:layout_centerVertical="true"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/measure_info_re_height"
                    android:layout_marginEnd="@dimen/plotInfo_margin_one_five"
                    android:layout_alignParentEnd="true"
                    tools:ignore="RelativeOverlap">
                    <TextView
                        android:layout_centerVertical="true"
                        android:autofillHints="location"
                        android:inputType="textPostalAddress"
                        android:id="@+id/editDistrict"
                        android:background="@null"
                        android:hint="@string/infoDistrict_hint"
                        android:textSize="@dimen/address_edit_text_size"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:ignore="TextViewEdits" />
                    <ImageButton
                        android:layout_centerVertical="true"
                        android:id="@+id/imageButtonDistrict"
                        style="?attr/materialIconButtonStyle"
                        android:layout_marginStart="5dp"
                        android:layout_toEndOf="@+id/editDistrict"
                        android:layout_width="@dimen/measure_enter_imageButton"
                        android:layout_height="@dimen/measure_enter_imageButton"
                        android:contentDescription="@string/hint_enter"
                        android:src="@mipmap/enter"/>
                </RelativeLayout>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/hamlet"
                android:background="@drawable/style_info"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <TextView
                    android:layout_marginStart="@dimen/plotInfo_margin_one_five"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/plotInfo_margin"
                    android:textSize="@dimen/plotInfoSize"
                    android:id="@+id/tv_yourHamlet"
                    android:text="@string/yourHamlet"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <RelativeLayout
                    android:id="@+id/rl_hamlet"
                    android:layout_centerVertical="true"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/measure_info_re_height"
                    android:layout_marginEnd="@dimen/plotInfo_margin_one_five"
                    android:layout_alignParentEnd="true"
                    tools:ignore="RelativeOverlap">
                    <TextView
                        android:layout_centerVertical="true"
                        android:autofillHints="location"
                        android:inputType="textPostalAddress"
                        android:id="@+id/editHamlet"
                        android:background="@null"
                        android:hint="@string/infoHamlet_hint"
                        android:textSize="@dimen/address_edit_text_size"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <ImageButton
                        android:layout_centerVertical="true"
                        android:id="@+id/imageButtonHamlet"
                        style="?attr/materialIconButtonStyle"
                        android:layout_marginStart="5dp"
                        android:layout_toEndOf="@+id/editHamlet"
                        android:layout_width="@dimen/measure_enter_imageButton"
                        android:layout_height="@dimen/measure_enter_imageButton"
                        android:contentDescription="@string/hint_enter"
                        android:src="@mipmap/enter"/>
                </RelativeLayout>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/village"
                android:background="@drawable/style_info"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <TextView
                    android:layout_marginStart="@dimen/plotInfo_margin_one_five"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/plotInfo_margin"
                    android:textSize="@dimen/plotInfoSize"
                    android:id="@+id/tv_yourVillage"
                    android:text="@string/yourVillage"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <RelativeLayout
                    android:id="@+id/rl_village"
                    android:layout_centerVertical="true"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/measure_info_re_height"
                    android:layout_marginEnd="@dimen/plotInfo_margin_one_five"
                    android:layout_alignParentEnd="true"
                    tools:ignore="RelativeOverlap">
                    <TextView
                        android:layout_centerVertical="true"
                        android:autofillHints="location"
                        android:inputType="textPostalAddress"
                        android:id="@+id/editVillage"
                        android:background="@null"
                        android:hint="@string/infoVillage_hint"
                        android:textSize="@dimen/address_edit_text_size"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:ignore="TextViewEdits" />
                    <ImageButton
                        android:layout_centerVertical="true"
                        android:id="@+id/imageButtonVillage"
                        style="?attr/materialIconButtonStyle"
                        android:layout_marginStart="5dp"
                        android:layout_toEndOf="@+id/editVillage"
                        android:layout_width="@dimen/measure_enter_imageButton"
                        android:layout_height="@dimen/measure_enter_imageButton"
                        android:contentDescription="@string/hint_enter"
                        android:src="@mipmap/enter"/>
                </RelativeLayout>
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_marginStart="@dimen/plotInfo_margin_one_five"
        android:layout_marginEnd="@dimen/plotInfo_margin_one_five"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.48"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/relativeLayout_two"
            android:orientation="vertical">
        <RelativeLayout
            android:id="@+id/detail_info_relative"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.08">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:layout_centerVertical="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/style_icon_bigger"/>
                <TextView
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/plotInfo_margin_one_five"
                    android:layout_marginEnd="@dimen/plotInfo_margin"
                    android:id="@+id/tv_plotInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/plotInfoText"
                    android:textStyle="bold"
                    android:textSize="@dimen/measure_info_text_size"/>
            </RelativeLayout>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.7"
            android:background="@color/white">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <RelativeLayout
                    android:layout_marginEnd="@dimen/plotInfo_margin"
                    android:background="@drawable/style_info"
                    android:layout_marginStart="@dimen/plotInfo_margin_one_five"
                    android:id="@+id/linearLayout_plot_number"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="0.1">
                    <TextView
                        android:layout_centerVertical="true"
                        android:id="@+id/tv_plot_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/plotNumber"
                        android:textStyle="bold"
                        android:textSize="@dimen/measure_info_text_size"/>
                    <EditText
                        android:layout_centerVertical="true"
                        android:gravity="end"
                        android:textAlignment="textEnd"
                        android:layout_marginEnd="@dimen/plotInfo_margin_one_five"
                        android:autofillHints="plotName"
                        android:inputType="text"
                        android:id="@+id/editPlotName"
                        android:textSize="@dimen/plotInfoSize"
                        android:layout_marginStart="@dimen/plotInfo_margin_four"
                        android:background="@null"
                        android:layout_alignParentEnd="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:hint="@string/plot_number"
                        tools:ignore="RelativeOverlap" />
                </RelativeLayout>
                <RelativeLayout
                    android:layout_marginEnd="@dimen/plotInfo_margin"
                    android:background="@drawable/style_info"
                    android:layout_marginStart="@dimen/plotInfo_margin_one_five"
                    android:id="@+id/linearLayout_plot_type"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="0.1">
                    <TextView
                        android:layout_centerVertical="true"
                        android:id="@+id/tv_plot_type"
                        android:text="@string/plotType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="@dimen/measure_info_text_size"/>
                    <RelativeLayout
                        android:id="@+id/rl_landPlot_type"
                        android:layout_width="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_height="@dimen/measure_info_re_height"
                        android:layout_marginEnd="@dimen/plotInfo_margin_one_five"
                        android:layout_alignParentEnd="true"
                        tools:ignore="RelativeOverlap">
                        <TextView
                            android:layout_centerVertical="true"
                            android:id="@+id/spinner"
                            android:layout_alignParentStart="true"
                            android:hint="@string/choose_type"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/measure_info_re_height"
                            android:textAlignment="textEnd"
                            android:textSize="@dimen/address_edit_text_size" />
                        <ImageButton
                            android:layout_centerVertical="true"
                            style="?attr/materialIconButtonStyle"
                            android:id="@+id/btn_landPlot_type"
                            android:layout_toEndOf="@id/spinner"
                            android:layout_width="@dimen/measure_enter_imageButton"
                            android:layout_height="@dimen/measure_enter_imageButton"
                            android:contentDescription="@string/choose_type"
                            android:src="@mipmap/enter"/>
                    </RelativeLayout>
                </RelativeLayout>
                <RelativeLayout
                    android:layout_marginEnd="@dimen/plotInfo_margin"
                    android:background="@drawable/style_info"
                    android:layout_marginStart="@dimen/plotInfo_margin_one_five"
                    android:id="@+id/linearLayout_plot_measure_method"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="0.1">
                    <TextView
                        android:layout_centerVertical="true"
                        android:id="@+id/tv_plot_measure_method"
                        android:text="@string/plotMethod"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="@dimen/measure_info_text_size"/>
                    <RelativeLayout
                        android:id="@+id/rl_landPlot_measure_method"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/measure_info_re_height"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="@dimen/plotInfo_margin_one_five"
                        android:layout_alignParentEnd="true"
                        tools:ignore="RelativeOverlap">
                        <TextView
                            android:layout_centerVertical="true"
                            android:id="@+id/spinner_measure_method"
                            android:layout_alignParentStart="true"
                            android:hint="@string/choose_type"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/measure_info_re_height"
                            android:textAlignment="textEnd"
                            android:textSize="@dimen/address_edit_text_size" />
                        <ImageButton
                            android:layout_centerVertical="true"
                            style="?attr/materialIconButtonStyle"
                            android:id="@+id/btn_landPlot_measure_method"
                            android:layout_toEndOf="@id/spinner_measure_method"
                            android:layout_width="@dimen/measure_enter_imageButton"
                            android:layout_height="@dimen/measure_enter_imageButton"
                            android:contentDescription="@string/choose_type"
                            android:src="@mipmap/enter"/>
                    </RelativeLayout>
                </RelativeLayout>
                <RelativeLayout
                    android:layout_marginEnd="@dimen/plotInfo_margin"
                    android:background="@drawable/style_info"
                    android:layout_marginStart="@dimen/plotInfo_margin_one_five"
                    android:id="@+id/linearLayout_measure_name"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="0.1">
                    <TextView
                        android:layout_centerVertical="true"
                        android:id="@+id/tv_measure_name"
                        android:text="@string/measure_name"
                        android:textSize="@dimen/measure_info_text_size"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:layout_marginEnd="@dimen/plotInfo_margin_one_five"
                        android:autofillHints="name"
                        android:textStyle="bold"
                        android:textSize="@dimen/measure_info_text_size"
                        android:id="@+id/edit_measure_name"
                        android:layout_marginStart="@dimen/plotInfo_margin_zero"
                        android:layout_centerVertical="true"
                        android:background="@null"
                        android:layout_alignParentEnd="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:ignore="RelativeOverlap" />
                </RelativeLayout>
                <RelativeLayout
                    android:layout_marginEnd="@dimen/plotInfo_margin"
                    android:background="@drawable/style_info"
                    android:layout_marginStart="@dimen/plotInfo_margin_one_five"
                    android:id="@+id/linearLayout_measure_phone"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="0.1">
                    <TextView
                        android:layout_centerVertical="true"
                        android:id="@+id/tv_measure_phone"
                        android:text="@string/measure_phone"
                        android:textSize="@dimen/measure_info_text_size"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:layout_marginEnd="@dimen/plotInfo_margin_one_five"
                        android:id="@+id/edit_measure_phone"
                        android:textStyle="bold"
                        android:layout_marginStart="@dimen/plotInfo_margin_zero"
                        android:layout_centerVertical="true"
                        android:autofillHints="phone"
                        android:background="@null"
                        android:textSize="@dimen/measure_info_text_size"
                        android:layout_alignParentEnd="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:ignore="RelativeOverlap" />
                </RelativeLayout>
                <RelativeLayout
                    android:layout_marginEnd="@dimen/plotInfo_margin"
                    android:background="@drawable/style_info"
                    android:layout_marginStart="@dimen/plotInfo_margin_one_five"
                    android:id="@+id/linearLayout_owner_name"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="0.1">
                    <TextView
                        android:layout_centerVertical="true"
                        android:id="@+id/tv_owner_name"
                        android:text="@string/owner_name"
                        android:textSize="@dimen/measure_info_text_size"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <EditText
                        android:layout_marginEnd="@dimen/plotInfo_margin_one_five"
                        android:id="@+id/edit_owner_name"
                        android:textAlignment="textEnd"
                        android:layout_marginStart="@dimen/plotInfo_margin_zero"
                        android:layout_centerVertical="true"
                        android:autofillHints="phone"
                        android:background="@null"
                        android:hint="@string/input_owner_name"
                        android:textSize="@dimen/measure_info_text_size"
                        android:layout_alignParentEnd="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:ignore="RelativeOverlap" />
                </RelativeLayout>
                <RelativeLayout
                    android:layout_marginEnd="@dimen/plotInfo_margin"
                    android:background="@drawable/style_info"
                    android:layout_marginStart="@dimen/plotInfo_margin_one_five"
                    android:id="@+id/linearLayout_owner_phone"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="0.1">
                    <TextView
                        android:layout_centerVertical="true"
                        android:id="@+id/tv_owner_phone"
                        android:text="@string/owner_phone"
                        android:textSize="@dimen/measure_info_text_size"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <EditText
                        android:layout_marginEnd="@dimen/plotInfo_margin_one_five"
                        android:id="@+id/edit_owner_phone"
                        android:textAlignment="textEnd"
                        android:layout_marginStart="@dimen/plotInfo_margin_zero"
                        android:layout_centerVertical="true"
                        android:autofillHints="phone"
                        android:hint="@string/input_owner_phone"
                        android:background="@null"
                        android:textSize="@dimen/measure_info_text_size"
                        android:layout_alignParentEnd="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:ignore="RelativeOverlap" />
                </RelativeLayout>
            </LinearLayout>
        </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.12"
        android:orientation="vertical">
        <Button
            android:layout_centerVertical="true"
            android:id="@+id/buttonStartMeasure"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:text="@string/measure_start"
            android:textSize="@dimen/measure_info_text_size"
            tools:ignore="TouchTargetSizeCheck" />
    </RelativeLayout>
</LinearLayout>