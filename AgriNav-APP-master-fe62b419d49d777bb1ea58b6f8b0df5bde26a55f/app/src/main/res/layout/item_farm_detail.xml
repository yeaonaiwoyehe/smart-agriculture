<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/item_farm_detail_card_height"
    android:layout_margin="@dimen/item_farm_detail_card_margin"
    android:background="@color/white"
    app:cardCornerRadius="@dimen/item_farm_detail_card_corner_radius"
    app:strokeWidth="@dimen/item_farm_detail_card_stroke_width"
    app:cardElevation="@dimen/item_farm_detail_card_elevation">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/iv_find_farm_image"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_farm_detail_image_height"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/item_farm_detail_content_margin_top"
            android:layout_marginLeft="@dimen/item_farm_detail_content_margin_left">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_margin="@dimen/item_farm_detail_task_margin"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_task_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/item_farm_detail_text_padding"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="@dimen/item_farm_detail_title_text_size" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_margin="@dimen/item_farm_detail_task_margin"
                android:layout_height="@dimen/item_farm_detail_task_height"
                android:layout_weight="1"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/find_farm_title_style"
                    android:backgroundTint="#7ae3b9"
                    android:padding="@dimen/item_farm_detail_text_padding"
                    android:text="@string/item_farm_detail_plot_size"
                    android:textColor="@color/white"
                    android:textSize="@dimen/item_farm_detail_label_text_size" />

                <TextView
                    android:id="@+id/tv_find_farm_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/item_farm_detail_text_padding"
                    android:textColor="@color/black"
                    android:textSize="@dimen/item_farm_detail_title_text_size" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_margin="@dimen/item_farm_detail_task_margin"
                android:layout_height="@dimen/item_farm_detail_task_height"
                android:layout_weight="1"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/find_farm_title_style"
                    android:backgroundTint="#7ac5e3"
                    android:padding="@dimen/item_farm_detail_text_padding"
                    android:text="@string/item_farm_detail_crop_type"
                    android:textColor="@color/white"
                    android:textSize="@dimen/item_farm_detail_label_text_size" />

                <TextView
                    android:id="@+id/tv_crop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/item_farm_detail_text_padding"
                    android:textColor="@color/black"
                    android:textSize="@dimen/item_farm_detail_title_text_size" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_margin="@dimen/item_farm_detail_task_margin"
                android:layout_height="@dimen/item_farm_detail_task_height"
                android:layout_weight="1"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/find_farm_title_style"
                    android:backgroundTint="#beb0e5"
                    android:padding="@dimen/item_farm_detail_text_padding"
                    android:text="@string/item_farm_detail_operation_type"
                    android:textColor="@color/white"
                    android:textSize="@dimen/item_farm_detail_label_text_size" />

                <TextView
                    android:id="@+id/tv_operation_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/item_farm_detail_text_padding"
                    android:textColor="@color/black"
                    android:textSize="@dimen/item_farm_detail_title_text_size" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_margin="@dimen/item_farm_detail_task_margin"
                android:layout_height="@dimen/item_farm_detail_task_height"
                android:layout_weight="1"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/find_farm_title_style"
                    android:backgroundTint="#7a89e3"
                    android:padding="@dimen/item_farm_detail_text_padding"
                    android:text="@string/item_farm_detail_valid_period"
                    android:textColor="@color/white"
                    android:textSize="@dimen/item_farm_detail_label_text_size" />

                <TextView
                    android:id="@+id/tv_operation_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/item_farm_detail_text_padding"
                    android:textColor="@color/black"
                    android:textSize="@dimen/item_farm_detail_title_text_size" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_publish_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:layout_marginLeft="1dp"
                android:textColor="@color/black"
                android:textSize="@dimen/item_farm_detail_label_text_size" />
        </LinearLayout>

    </LinearLayout>
    <LinearLayout
        android:id="@+id/farm_choose_open"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99CECED0"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_view_farm_detail"
            android:layout_width="@dimen/item_farm_detail_button_width"
            android:layout_height="wrap_content"
            android:text="@string/item_farm_detail_view_details"
            android:textColor="@color/black"
            android:textSize="@dimen/item_farm_detail_button_text_size"
            android:padding="@dimen/item_farm_detail_button_padding"
            android:background="@drawable/popup_button_background"
            android:layout_marginBottom="@dimen/item_farm_detail_button_margin_bottom"/>
        <TextView
            android:id="@+id/tv_update_farm_detail"
            android:layout_width="@dimen/item_farm_detail_button_width"
            android:layout_height="wrap_content"
            android:text="@string/item_farm_detail_edit_info"
            android:textColor="@color/black"
            android:textSize="@dimen/item_farm_detail_button_text_size"
            android:padding="@dimen/item_farm_detail_button_padding"
            android:background="@drawable/popup_button_background"
            android:layout_marginBottom="@dimen/item_farm_detail_button_margin_bottom"/>

        <TextView
            android:id="@+id/tv_remove_farm"
            android:layout_width="@dimen/item_farm_detail_button_width"
            android:layout_height="wrap_content"
            android:text="@string/item_farm_detail_remove"
            android:textColor="@color/black"
            android:textSize="@dimen/item_farm_detail_button_text_size"
            android:padding="@dimen/item_farm_detail_button_padding"
            android:background="@drawable/popup_button_background"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>