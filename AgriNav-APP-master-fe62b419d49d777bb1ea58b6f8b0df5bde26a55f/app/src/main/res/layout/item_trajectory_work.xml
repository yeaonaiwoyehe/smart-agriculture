<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/trajectory_style_no_border_radius"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_trajectory_item_work_show"
        android:layout_width="@dimen/trajectory_font_item_img_size"
        android:layout_height="@dimen/trajectory_font_item_img_size"
        android:layout_gravity="center"
        app:shapeAppearance="@style/trajectory_img"
        tools:src="@drawable/ic_launcher_background"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_marginStart="@dimen/trajectory_font_item_img_margin"
        android:paddingBottom="@dimen/trajectory_text_background_padding">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="@integer/trajectory_weight_small"
            android:gravity="center_vertical">
            <TextView
                android:textStyle="bold"
                android:id="@+id/tv_trajectory_font_item_work_address"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/trajectory_work_item_content_text_size"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="@integer/trajectory_weight_small">
            <TextView
                android:text="@string/trajectory_font_item_time_begin"
                android:layout_width="wrap_content"
                android:background="@drawable/trajectory_style_text"
                android:textSize="@dimen/trajectory_work_item_content_text_size"
                android:layout_height="wrap_content"
                android:padding="@dimen/trajectory_text_background_padding"
                android:textColor="@color/white"/>
            <TextView
                android:paddingStart="@dimen/trajectory_text_background_padding"
                android:id="@+id/tv_trajectory_font_item_work_time_begin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/trajectory_work_item_content_text_size"
                tools:ignore="RtlSymmetry" />
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="@integer/trajectory_weight_small">
            <TextView
                android:text="@string/trajectory_font_item_time_end"
                android:layout_width="wrap_content"
                android:textSize="@dimen/trajectory_work_item_content_text_size"
                android:background="@drawable/trajectory_style_text"
                android:padding="@dimen/trajectory_text_background_padding"
                android:layout_height="wrap_content"
                android:textColor="@color/white"/>
            <TextView
                android:paddingStart="@dimen/trajectory_text_background_padding"
                android:id="@+id/tv_trajectory_font_item_work_time_end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/trajectory_work_item_content_text_size"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="@integer/trajectory_weight_small"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/trajectory_style_text"
                android:backgroundTint="@color/trajectory_text_background_work_type_color"
                android:padding="@dimen/trajectory_text_background_padding"
                android:text="@string/trajectory_font_item_work_type"
                android:textColor="@color/white"
                android:textSize="@dimen/trajectory_work_item_content_text_size" />
            <TextView
                android:paddingStart="@dimen/trajectory_text_background_padding"
                android:id="@+id/tv_trajectory_font_item_work_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/trajectory_work_item_content_text_size"
                tools:ignore="RtlSymmetry" />
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="@integer/trajectory_weight_small">
            <TextView
                android:paddingStart="@dimen/trajectory_text_background_padding"
                android:text="@string/trajectory_font_item_width"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/trajectory_style_text"
                android:padding="@dimen/trajectory_text_background_padding"
                android:backgroundTint="@color/trajectory_text_background_width_color"
                android:textSize="@dimen/trajectory_work_item_content_text_size"
                android:textColor="@color/white"
                tools:ignore="RtlSymmetry" />
            <TextView
                android:paddingStart="@dimen/trajectory_text_background_padding"
                android:id="@+id/tv_trajectory_font_item_work_width"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/trajectory_work_item_content_text_size" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>