<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layout_margin="@dimen/security_margin_around_max">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/security_phone_verify"
        android:textSize="@dimen/security_text_size_max"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:layout_margin="@dimen/security_margin_around_mid"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/security_margin_around_mid"
        android:background="@color/grey" />

    <EditText
        android:id="@+id/edt_phone_old_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/security_phone_old_input"
        android:textSize="@dimen/security_text_size_mid"
        android:inputType="phone"
        android:maxLength="@integer/phone_length"/>

    <Button
        android:id="@+id/btn_old_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/security_phone_next"
        android:textSize="@dimen/security_text_size_mid"
        android:textColor="@color/white"
        android:layout_margin="@dimen/security_margin_around_mid"/>

</LinearLayout>