<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    tools:openDrawer="start"
    tools:layout_gravity="start"
    android:orientation="vertical"
    android:fitsSystemWindows="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/gridView_white">
<!--           第一行-->
        <RelativeLayout
            android:id="@+id/first_line"
            android:layout_width="match_parent"
            android:layout_height="@dimen/Relative_height"
            android:background="@drawable/style_fm_line_first"
            android:orientation="horizontal">
            <TextView
                android:layout_centerInParent="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Relative_textView_measure"
                android:textSize="@dimen/Relative_textView_textSize"
                android:textColor="@color/white"/>
        </RelativeLayout>
<!--           第二行搜索和按钮-->
        <RelativeLayout
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="@dimen/Relative_second_height">
            <RelativeLayout
                android:layout_margin="@dimen/Relative_second_relative_search_margin"
                android:layout_width="@dimen/Relative_second_relative_search_width"
                android:layout_height="@dimen/Relative_second_relative_search_height"
                android:orientation="horizontal"
                android:background="@drawable/style_fm_relative_second_second_search">
                <SearchView
                    android:id="@+id/searchView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:iconifiedByDefault="false"
                    android:queryHint="@string/search_hint"
                    android:queryBackground="@android:color/transparent"/>
                <RelativeLayout
                    android:id="@+id/Search"
                    android:layout_centerVertical="true"
                    android:background="@drawable/style_fm_relative_second_query"
                    android:layout_width="@dimen/Relative_second_relative_search_button_width"
                    android:layout_height="@dimen/Relative_second_relative_search_button_height"
                    android:layout_marginStart="@dimen/Relative_second_relative_search_button_marginLeft">
                    <TextView
                        android:layout_centerVertical="true"
                        android:layout_centerHorizontal="true"
                        android:layout_width="@dimen/Relative_second_relative_search_button_text_width"
                        android:layout_height="@dimen/Relative_second_relative_search_button_text_height"
                        android:text="@string/text"
                        android:textColor="@color/measure_black"
                        android:textSize="@dimen/Relative_second_relative_search_button_text_size"/>
                </RelativeLayout>
            </RelativeLayout>
            <ImageButton
                style="?attr/materialIconButtonStyle"
                android:id="@+id/buttonMeasure"
                android:layout_width="@dimen/Relative_second_relative_search_imageButton_width"
                android:layout_height="@dimen/Relative_second_relative_search_imageButton_height"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/Relative_second_relative_search_imageButton_marginLeft"
                android:src="@mipmap/gauge"
                android:contentDescription="@string/button_measure_default_text"/>
            <ImageButton
                style="?attr/materialIconButtonStyle"
                android:id="@+id/buttonCheck"
                android:layout_width="@dimen/Relative_second_relative_search_imageButton_width"
                android:layout_height="@dimen/Relative_second_relative_search_imageButton_height"
                android:layout_marginStart="@dimen/Relative_second_relative_search_imageButton_marginLeftTwo"
                android:src="@mipmap/check"
                android:layout_centerVertical="true"
                android:contentDescription="@string/button_check_default_text"/>
        </RelativeLayout>
<!--           第三行-->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/gridView_white">
            <com.scwang.smart.refresh.layout.SmartRefreshLayout
                android:id="@+id/srl_landPlot"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.scwang.smart.refresh.header.ClassicsHeader
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <GridView
                    android:id="@+id/gridView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/gridView_item_margin"
                    android:layout_marginRight="@dimen/gridView_item_margin"
                    android:layout_marginTop="@dimen/gridView_first_line_item_marginTop"
                    android:horizontalSpacing="@dimen/gridView_item_space"
                    android:verticalSpacing="@dimen/gridView_item_space"
                    android:numColumns="@integer/gridView_numColumn" />
                <com.scwang.smart.refresh.footer.ClassicsFooter
                    app:srlTextFailed="@string/no_more_data"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </com.scwang.smart.refresh.layout.SmartRefreshLayout>
        </RelativeLayout>
    </LinearLayout>
     <!-- 替换原有侧边栏为 NavigationView -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_measure_select"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        app:headerLayout="@layout/navigation_measure_select"/>
</androidx.drawerlayout.widget.DrawerLayout>