<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@mipmap/bg" />
    <TextView
        android:id="@+id/tv_wx_verification_code_input"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/verification_code_input"
        android:textStyle="bold"
        android:textSize="@dimen/verification_text_view_text_size_big"
        android:layout_alignStart="@id/ll_wx_verification_and_btn"
        android:layout_above="@+id/tv_wx_verification_code_wait"
        android:fontFamily="@font/ping_fang"
        android:layout_marginBottom="@dimen/verification_margin_mid"/>
    <TextView
        android:id="@+id/tv_wx_verification_code_wait"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/verification_code_wait"
        android:layout_above="@id/ll_wx_verification_and_btn"
        android:layout_alignStart="@id/ll_wx_verification_and_btn"
        android:fontFamily="@font/ping_fang"
        android:textSize="@dimen/verification_text_view_text_size_small" />
    <TextView
        android:id="@+id/tv_wx_verification_code_phone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="15531069469"
        android:visibility="invisible"
        android:textSize="@dimen/verification_text_view_text_size_small"
        android:fontFamily="@font/ping_fang"
        android:layout_alignBaseline="@id/tv_wx_verification_code_wait"
        android:layout_toEndOf="@id/tv_wx_verification_code_wait"/>
    <LinearLayout
        android:id="@+id/ll_wx_verification_and_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_centerInParent="true">
        <cn.agrinav.user.VerificationCodeView
            android:id="@+id/edt_wx_verification_code"
            android:layout_width="@dimen/verification_code_line_width"
            android:layout_height="wrap_content"
            android:cursorVisible="false"
            android:enabled="true"
            android:focusable="true"
            android:inputType="number"
            android:maxLength="@integer/verification_code_length"
            app:beforeLineColor="@color/grey_s"
            app:bgBorderRadius="@dimen/verification_code_size_big"
            app:bgHeightWidth="@dimen/verification_margin_plus"
            app:codeLength="@integer/verification_code_length"
            app:currentLineColor="@color/green"
            app:lineHeight="@dimen/verification_code_line_height"
            app:space="@dimen/verification_code_line_space"
            app:textColor="@color/black"
            app:textSize="@dimen/verification_code_size_big"
            android:fontFamily="@font/ping_fang"
            android:layout_marginBottom="@dimen/login_margin_small"/>
        <Button
            android:id="@+id/btn_wx_verification_code_get_code"
            android:layout_width="@dimen/verification_btn_width"
            android:layout_height="wrap_content"
            android:text="@string/verification_code_get"
            android:fontFamily="@font/ping_fang"
            android:textSize="@dimen/verification_btn_text_size"
            android:layout_gravity="center"/>
    </LinearLayout>
</RelativeLayout>