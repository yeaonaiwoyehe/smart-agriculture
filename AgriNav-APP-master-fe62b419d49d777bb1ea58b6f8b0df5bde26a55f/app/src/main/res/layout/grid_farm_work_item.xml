<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="170dp"
    android:layout_height="245dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/style_grid_machinery_item">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/farm_work_picture"
        android:layout_width="170dp"
        android:layout_height="121dp"
        android:contentDescription="@string/farm_work_photos"
        android:scaleType="center"
        android:layout_gravity="center"
        app:shapeAppearance="@style/common"/>
    <RelativeLayout
        android:id="@+id/rl_plot_area_mu"
        android:background="@drawable/style_tv_plot_area"
        android:layout_marginTop="12dp"
        android:layout_marginStart="9dp"
        android:layout_below="@+id/farm_work_picture"
        android:layout_width="66dp"
        android:layout_height="22dp">
        <TextView
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:text="@string/plot_mu"
            android:textSize="10sp"/>
    </RelativeLayout>
    <TextView
        android:id="@+id/tv_farm_work_plot_area_edit"
        android:layout_marginTop="16dp"
        android:layout_marginStart="5dp"
        android:layout_below="@+id/farm_work_picture"
        android:layout_toEndOf="@id/rl_plot_area_mu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"/>
    <RelativeLayout
        android:id="@+id/rl_operation_area"
        android:background="@drawable/style_tv_operation_area"
        android:layout_marginStart="9dp"
        android:layout_below="@+id/rl_plot_area_mu"
        android:layout_marginTop="12dp"
        android:layout_width="66dp"
        android:layout_height="22dp">
        <TextView
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:text="@string/operable_area"
            android:textSize="10sp"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_farm_work_deadline"
        android:background="@drawable/style_farm_work_deadline"
        android:layout_marginStart="9dp"
        android:layout_below="@+id/rl_operation_area"
        android:layout_marginTop="12dp"
        android:layout_width="66dp"
        android:layout_height="22dp">
        <TextView
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:text="@string/deadline"
            android:textSize="10sp"/>
    </RelativeLayout>
    <TextView
        android:id="@+id/tv_operation_area"
        android:layout_marginStart="5dp"
        android:layout_marginTop="15dp"
        android:layout_below="@+id/tv_farm_work_plot_area_edit"
        android:layout_toEndOf="@id/rl_operation_area"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"/>
    <TextView
        android:id="@+id/tv_farm_work_deadline_edit"
        android:layout_marginStart="5dp"
        android:layout_marginTop="15dp"
        android:layout_below="@+id/rl_operation_area"
        android:layout_toEndOf="@id/rl_farm_work_deadline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"/>
    <TextView
        android:layout_marginStart="13dp"
        android:layout_marginTop="8dp"
        android:layout_below="@id/rl_farm_work_deadline"
        android:id="@+id/tv_other_date_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="10sp"/>
</RelativeLayout>