<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.4318">
        <ImageButton
            android:id="@+id/iv_farm_work_back"
            android:elevation="5dp"
            android:layout_marginStart="13dp"
            android:layout_marginTop="9dp"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/back"
            android:background="@null"
            android:src="@mipmap/back"/>
        <ImageButton
            android:src="@mipmap/share"
            android:elevation="5dp"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="13dp"
            android:layout_marginTop="9dp"
            android:id="@+id/iv_farm_work_share"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/share"
            android:background="@null"/>
        <com.youth.banner.Banner
            android:layout_below="@id/iv_farm_work_back"
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </RelativeLayout>
    <LinearLayout
        android:layout_marginTop="12dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.4408"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="0.03562"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="0.92875"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.0509"
                android:orientation="horizontal">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView
                        android:layout_alignParentTop="true"
                        android:background="@drawable/style_icon_bigger"
                        android:layout_width="4dp"
                        android:layout_height="28dp"/>
                    <TextView
                        android:layout_alignParentTop="true"
                        android:layout_marginStart="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:text="@string/detail"/>
                </RelativeLayout>
            </LinearLayout>
            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.3898"
                android:divider="@drawable/style_table_divider">
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="0.05987"
                    android:orientation="horizontal">
                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_weight="0.3452"
                        android:layout_height="match_parent">
                        <TextView
                            android:layout_centerHorizontal="true"
                            android:layout_centerVertical="true"
                            android:textStyle="bold"
                            android:text="@string/plot"
                            android:textSize="17sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_weight="0.6548"
                        android:layout_height="match_parent">
                        <TextView
                            android:id="@+id/tv_detail_page_address"
                            android:layout_centerVertical="true"
                            android:layout_centerHorizontal="true"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </RelativeLayout>
                </TableRow>
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="0.05222"
                    android:orientation="horizontal">
                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_weight="0.3452"
                        android:layout_height="match_parent">
                        <TextView
                            android:layout_centerHorizontal="true"
                            android:layout_centerVertical="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="17sp"
                            android:text="@string/plot_mu"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_weight="0.6548"
                        android:layout_height="match_parent">
                        <TextView
                            android:id="@+id/tv_detail_page_area"
                            android:layout_centerHorizontal="true"
                            android:layout_centerVertical="true"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </RelativeLayout>
                </TableRow>
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="0.0866"
                    android:orientation="horizontal">
                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_weight="0.3452"
                        android:layout_height="match_parent">
                        <TextView
                            android:layout_centerHorizontal="true"
                            android:layout_centerVertical="true"
                            android:textSize="17sp"
                            android:text="@string/work_area"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_weight="0.6548"
                        android:layout_height="match_parent">
                        <TextView
                            android:layout_height="wrap_content"
                            android:id="@+id/tv_detail_page_work_area_farm"
                            android:layout_centerHorizontal="true"
                            android:layout_centerVertical="true"
                            android:textSize="16sp"
                            android:textStyle="bold"
                           android:layout_width="wrap_content"/>
                        </RelativeLayout>
                </TableRow>
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="0.0636"
                    android:orientation="horizontal">
                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_weight="0.3452"
                        android:layout_height="match_parent">
                        <TextView
                            android:layout_centerHorizontal="true"
                            android:layout_centerVertical="true"
                            android:textSize="17sp"
                            android:text="@string/crops"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_weight="0.6548"
                        android:layout_height="match_parent">
                        <TextView
                            android:id="@+id/tv_detail_page_crops"
                            android:layout_centerHorizontal="true"
                            android:layout_centerVertical="true"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </RelativeLayout>
                </TableRow>
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="0.0636"
                    android:orientation="horizontal">
                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_weight="0.3452"
                        android:layout_height="match_parent">
                        <TextView
                            android:layout_centerHorizontal="true"
                            android:layout_centerVertical="true"
                            android:textSize="17sp"
                            android:text="@string/work_type"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_weight="0.6548"
                        android:layout_height="match_parent">
                        <TextView
                            android:layout_height="wrap_content"
                            android:id="@+id/tv_detail_page_work_type"
                            android:layout_centerHorizontal="true"
                            android:layout_centerVertical="true"
                            android:textSize="16sp"
                            android:textStyle="bold"
                           android:layout_width="wrap_content" />
                        </RelativeLayout>
                </TableRow>
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="0.06369"
                    android:orientation="horizontal">
                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_weight="0.3452"
                        android:layout_height="match_parent">
                        <TextView
                            android:layout_centerHorizontal="true"
                            android:layout_centerVertical="true"
                            android:textSize="17sp"
                            android:text="@string/deadline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_weight="0.6548"
                        android:layout_height="match_parent">
                        <TextView
                            android:layout_height="wrap_content"
                            android:id="@+id/tv_detail_page_deadline"
                            android:layout_centerHorizontal="true"
                            android:layout_centerVertical="true"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_width="wrap_content" />
                    </RelativeLayout>
                </TableRow>
            </TableLayout>
        </LinearLayout>
        <RelativeLayout
            android:layout_width="0dp"
            android:layout_weight="0.03562"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <LinearLayout
        android:layout_marginTop="15dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.0687"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">
        <RelativeLayout
            android:id="@+id/rl_detail_page_inquire_farm"
            android:layout_width="0dp"
            android:layout_weight="0.3307"
            android:layout_height="match_parent">
            <ImageView
                android:src="@mipmap/tip"
                android:layout_above="@id/tv_inquire_farm"
                android:layout_centerHorizontal="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/please_inquire" />
            <TextView
                android:id="@+id/tv_inquire_farm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/please_inquire"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_detail_page_call_farm"
            android:background="@drawable/style_fm_line_first"
            android:layout_width="0dp"
            android:layout_weight="0.6693"
            android:layout_height="match_parent">
            <ImageView
                android:layout_marginEnd="5dp"
                android:src="@mipmap/phone"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/tv_phone_inquire_farm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/telephone_contact" />
            <TextView
                android:id="@+id/tv_phone_inquire_farm"
                android:layout_centerVertical="true"
                android:layout_centerHorizontal="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/telephone_contact"
                android:textSize="20sp"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>