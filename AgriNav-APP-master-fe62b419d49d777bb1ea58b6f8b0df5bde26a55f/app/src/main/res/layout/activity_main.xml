<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_gravity="top">

        <ImageView
            android:id="@+id/img_top"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:scaleType="fitXY" />

        <Button
            android:theme="@style/Theme.MaterialComponents.DayNight.DarkActionBar.Bridge"
            android:id="@+id/btn_jumper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="@dimen/page_padding"
            android:background="@android:color/transparent"
            android:text="@string/jump"
            android:textSize="17sp"
            android:textColor="@color/half_transparent_white"
            tools:ignore="RelativeOverlap" />

    </RelativeLayout>

    <FrameLayout
        android:id="@+id/fl_bottom"
        android:layout_width="match_parent"
        android:layout_height="108dp"
        android:background="@mipmap/bg_guide" />

</LinearLayout>