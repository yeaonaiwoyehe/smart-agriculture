<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">
    <com.amap.api.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" >
    </com.amap.api.maps.MapView>
    <Button
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_marginStart="@dimen/m_button_relative_marginLeft"
        android:layout_marginBottom="@dimen/m_button_relative_marginBottom"
        android:id="@+id/buttonHandStart"
        style="?attr/materialIconButtonFilledStyle"
        android:layout_width="@dimen/m_button_relative_width"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:text="@string/commence"
        android:textColor="@color/white"
        android:textSize="@dimen/m_button_relative_text_size"
        app:icon="@mipmap/begin"
        app:strokeColor="@color/gridView_white"
        tools:ignore="TextContrastCheck" />
    <Button
        android:id="@+id/btn_pause"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="@dimen/m_button_relative_marginBottom"
        style="?attr/materialIconButtonFilledStyle"
        android:layout_width="@dimen/m_button_relative_width"
        android:layout_height="wrap_content"
        android:text="暂停"
        android:layout_centerHorizontal="true"/>
    <Button
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="@dimen/m_button_relative_marginLeft"
        android:layout_marginBottom="@dimen/m_button_relative_marginBottom"
        android:layout_alignParentBottom="true"
        style="?attr/materialIconButtonOutlinedStyle"
        app:strokeColor="@color/gridView_white"
        android:id="@+id/buttonEndMeasure"
        android:layout_width="@dimen/m_button_relative_width"
        android:layout_height="wrap_content"
        app:icon="@mipmap/over"
        android:layout_centerHorizontal="true"
        android:text="@string/complete"
        android:textColor="@color/green_hand_button"
        android:textSize="@dimen/m_button_relative_text_size"
        android:backgroundTint="@color/white"
        app:iconTint="@color/black"/>
</RelativeLayout>