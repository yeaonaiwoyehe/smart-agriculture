<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_height="match_parent"
    android:layout_width="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@mipmap/bg">
    </LinearLayout>
    <TextView
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:text="@string/wx_login_welcome"
        android:textSize="@dimen/login_register_text_size"
        android:layout_alignStart="@id/rl_wx_login_center"
        android:layout_marginVertical="@dimen/login_register_text_view_string_margin_small"
        android:fontFamily="@font/ping_fang"
        android:textStyle="bold"
        android:textColor="@color/black_text"
        android:layout_above="@id/login_toast"
        />
    <LinearLayout
        android:id="@+id/login_toast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/rl_wx_login_center"
        android:layout_alignStart="@id/rl_wx_login_center"
        android:layout_marginBottom="@dimen/login_register_text_view_string_margin_big">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wx_login_account_text"
            android:textColor="@color/black_text"
            android:textSize="@dimen/wx_login_text_size_small" />
        <TextView
            android:id="@+id/tv_wx_login_to_register"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_account_register"
            android:textColor="@color/green"
            android:textSize="@dimen/wx_login_text_size_small"
            android:fontFamily="@font/ping_fang"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/rl_wx_login_center"
        android:layout_width="@dimen/login_register_btn_width"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical">
        <Button
            android:id="@+id/btn_wx_login_confirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wx_login_text"
            android:textColor="@color/white"
            android:textSize="@dimen/wx_login_text_size_mid"
            android:layout_marginVertical="@dimen/login_register_btn_margin_vertical"/>
        <TextView
            android:id="@+id/tv_wx_login_other"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/wx_login_other_padding"
            android:text="@string/wx_login_other"
            android:gravity="center"
            android:textColor="@color/grey_b"
            android:fontFamily="@font/ping_fang"
            android:textSize="@dimen/wx_login_text_size_small" />

    </LinearLayout>

        <!--    服务条款-->
    <LinearLayout
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/wx_login_other_padding"
        android:layout_below="@id/rl_wx_login_center">
        <CheckBox
            android:id="@+id/rb_wx_login_protocol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/protocol_ok"
            android:fontFamily="@font/ping_fang"
            android:button="@drawable/icon_protocol_selector"
            android:paddingStart="@dimen/protocol_margin_or_padding"
            android:textSize="@dimen/protocol_text_size"
            tools:ignore="RtlSymmetry" />
        <TextView
            android:id="@+id/tv_wx_login_read_protocol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/protocol_see"
            android:fontFamily="@font/ping_fang"
            android:textSize="@dimen/protocol_text_size"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tv_wx_login_read_personal_protocol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/protocol_personal_see"
            android:fontFamily="@font/ping_fang"
            android:textSize="@dimen/protocol_text_size"
            android:textStyle="bold" />
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/wx_login_mask_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/half_transparent_black"
        android:gravity="center"
        android:visibility="gone">
        <ImageView
            android:id="@+id/iv_wx_login_loading"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="加载中"
            android:src="@drawable/img_loading"/>
    </RelativeLayout>
</RelativeLayout>
