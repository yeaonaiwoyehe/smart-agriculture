<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:id="@+id/gesture_bindPaint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/gesture_text"
        android:textSize="@dimen/gesture_text_size_big"
        android:textColor="@color/black_text"
        android:textStyle="bold"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="@dimen/gesture_margin_small"
        android:layout_above="@id/id_bindGestureLockViewGroup"
        android:fontFamily="@font/ping_fang" />
    <cn.agrinav.user.login.otherways.gesture.GestureLockViewGroup
        android:layout_centerInParent="true"
        android:id="@+id/id_bindGestureLockViewGroup"
        android:layout_width="270dp"
        android:layout_height="270dp"
        app:barrierMargin="20dp"
        app:color_no_finger_outer_circle="@color/grey"
        app:color_finger_up="@color/green"
        app:color_finger_on="@color/green"
        android:gravity="center_vertical"
        app:count="3"
        app:tryTimes="5"/>
</RelativeLayout>