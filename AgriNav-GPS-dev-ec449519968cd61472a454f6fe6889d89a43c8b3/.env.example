# AgriNav-GPS（JT/T 808 接入服务）环境变量清单
# 用法：复制本文件为 .env 并填写真实值（.env 已被 .gitignore 忽略），
# 或在 IDE 的运行配置 / 系统环境变量中设置下列变量。
# 不设置任何变量时，应用使用 localhost 默认值，可直接连本地基础服务。

# PostgreSQL/PostGIS
PG_HOST=localhost
PG_PORT=5432
PG_DB=AgriNav
PG_USER=postgres
PG_PASSWORD=agrinav

# Elasticsearch（原始点 / 媒体文件索引）
ES_HOST=localhost
ES_PORT=9200
ES_USER=
ES_PASSWORD=

# CMS 回调地址
CMS_HOST=localhost
CMS_PORT=8088

# 本地文件目录
JT_MEDIA_PATH=D:/jt_data/media_file
JT_MEDIA_URL_PREFIX=http://127.0.0.1:8100/media
JT_ALARM_PATH=D:/jt_data/alarm_file
