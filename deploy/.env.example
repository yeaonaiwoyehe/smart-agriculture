# ============================================================
# AgriNav（田界智航）云端部署环境变量
# 用法：复制本文件为 .env，按注释修改；.env 已被 gitignore，不要提交
# ============================================================

# 公网访问基础地址（用于把数据库里的图片 URL 重写为云端地址）
# 没有域名就填 http://服务器公网IP；有域名且配了 HTTPS 就填 https://你的域名
# 结尾不要带斜杠
PUBLIC_BASE_URL=http://CHANGE_ME_PUBLIC_IP

# ---------- MySQL（若依系统库 ry-vue）----------
MYSQL_DB=ry-vue
MYSQL_USER=root
MYSQL_PORT=3306
# 请改成强密码（字母+数字+符号，12位以上）
MYSQL_ROOT_PASSWORD=ChangeMe_MySQL_2026
MYSQL_PASSWORD=ChangeMe_MySQL_2026

# ---------- PostgreSQL / PostGIS（农业业务库 AgriNav）----------
PG_DB=AgriNav
PG_USER=postgres
PG_PORT=5432
PG_PASSWORD=ChangeMe_Pg_2026

# ---------- Redis（缓存/登录态）----------
REDIS_PORT=6379
REDIS_PASSWORD=ChangeMe_Redis_2026

# ---------- Elasticsearch（单节点，已关闭安全认证）----------
ES_PORT=9200
ES_USER=
ES_PASSWORD=
# ES 堆内存，4核4G 机器建议 512m
ES_JAVA_OPTS=-Xms512m -Xmx512m

# ---------- 后端令牌签名密钥（务必改成随机长串，至少32位）----------
TOKEN_SECRET=ChangeMe_to_a_random_secret_at_least_32_chars

# ---------- 微信 OAuth 占位（未启用真实微信登录，保留 dummy 即可）----------
WX_MOBILE_CLIENT_ID=dummy-id
WX_MOBILE_CLIENT_SECRET=dummy-secret
WX_WEB_CLIENT_ID=dummy-id
WX_WEB_CLIENT_SECRET=dummy-secret

# ---------- 短信演示模式（true=不真发短信，验证码走 mock，方便测试）----------
SMS_MOCK_ENABLED=true

# ---------- 容器内文件存储路径（一般无需修改）----------
AGRI_PROFILE=/app/upload
JT_MEDIA_PATH=/app/media
JT_ALARM_PATH=/app/alarm
