# ============================================================
# 本地开发环境变量模板
# 用法：把本文件复制一份，命名为 dev-local.env，然后找组长要密码，
#       把下面三处“找组长要”替换成真实密码，保存即可。
# 数据库已直接暴露公网，无需 SSH 隧道，直接连下面的公网地址即可。
# dev-local.env 已被 .gitignore 忽略，不会被提交，密码不会泄露。
# ============================================================

# MySQL（若依系统库）
MYSQL_HOST=82.156.224.217
MYSQL_PORT=3306
MYSQL_DB=ry-vue
MYSQL_USER=root
MYSQL_PASSWORD=找组长要

# PostgreSQL / PostGIS（农业业务库）
PG_HOST=82.156.224.217
PG_PORT=5432
PG_DB=AgriNav
PG_USER=postgres
PG_PASSWORD=找组长要

# Redis（缓存 / 登录态）
REDIS_HOST=82.156.224.217
REDIS_PORT=6379
REDIS_PASSWORD=找组长要

# Elasticsearch（搜索，边缘功能）
ES_HOST=82.156.224.217
ES_PORT=9200
ES_USER=
ES_PASSWORD=

# 微信登录（本项目已停用微信登录，这里填 dummy 占位即可，
# 仅用于让后端启动时的校验通过，不用改，也不用找组长要）
WX_MOBILE_CLIENT_ID=dummy
WX_MOBILE_CLIENT_SECRET=dummy
WX_WEB_CLIENT_ID=dummy
WX_WEB_CLIENT_SECRET=dummy
WX_WEB_REDIRECT_URI=http://localhost:80/login
