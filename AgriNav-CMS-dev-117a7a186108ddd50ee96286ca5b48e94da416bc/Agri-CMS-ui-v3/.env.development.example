# 页面标题
VITE_APP_TITLE = 农业土地与作物种植面积监测系统

# 开发环境配置
VITE_APP_ENV = development

# 开发环境接口前缀（由 vite proxy 转发到 http://localhost:8088）
VITE_APP_BASE_API = /dev-api

# 开发端口
VITE_PORT = 81

# 高德地图 Web 端（JS API）配置：请复制本文件为 .env.development，并替换为你申请的 Key 与安全密钥
# 申请地址：https://console.amap.com/dev/key/app
VITE_APP_AMAP_KEY = your_amap_js_key
VITE_APP_AMAP_SECURITY_CODE = your_amap_security_code
