# 页面标题
VUE_APP_TITLE = 农业土地与作物种植面积监测系统

# 开发环境配置
ENV = 'development'

# 农业土地与作物种植面积监测系统/开发环境
VUE_APP_BASE_API = '/dev-api'

# 路由懒加载
VUE_CLI_BABEL_TRANSPILE_MODULES = true

# 高德地图 Web 端（JS API）配置：请复制本文件为 .env.development，并替换为你申请的 Key 与安全密钥
# 申请地址：https://console.amap.com/dev/key/app
VUE_APP_AMAP_KEY = your_amap_js_key
VUE_APP_AMAP_SECURITY_CODE = your_amap_security_code
