# AgriNav-CMS 环境变量清单
# 用法：复制本文件为 .env 并填写真实值（.env 已被 .gitignore 忽略），
# 或在 IDE 的运行配置 / 系统环境变量中设置下列变量。
# 不设置任何变量时，应用使用 localhost 默认值，可直接连本地基础服务。

# Druid 监控页（/druid）
DRUID_LOGIN_USER=ruoyi
DRUID_LOGIN_PASSWORD=123456

# MySQL（若依系统表）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=ry-vue
MYSQL_USER=root
MYSQL_PASSWORD=

# PostgreSQL/PostGIS（农业业务表）
PG_HOST=localhost
PG_PORT=5432
PG_DB=AgriNav
PG_USER=postgres
PG_PASSWORD=agrinav

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# InfluxDB（轨迹时序点）
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=
INFLUX_BUCKET=trajectory
INFLUX_ORG=agrinav

# Elasticsearch（原始轨迹点）
ES_HOST=localhost
ES_PORT=9200
ES_USER=
ES_PASSWORD=
ES_INDEX=original_point

# Kafka
KAFKA_BOOTSTRAP=localhost:9092

# MinIO（地图/文件对象存储）
MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=bkt-map

# 腾讯云短信
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
SMS_APP_ID=
SMS_SIGN=田界智航APP
SMS_TEMPLATE_ID=
# 短信演示模式：true=不真实发短信，验证码写日志并在 /captcha 接口返回 mockCode（本地默认开启）
SMS_MOCK_ENABLED=true

# 微信开放平台（移动应用 / 网站应用）
WX_MOBILE_CLIENT_ID=
WX_MOBILE_CLIENT_SECRET=
WX_WEB_CLIENT_ID=
WX_WEB_CLIENT_SECRET=
WX_WEB_REDIRECT_URI=http://localhost:80/login

# 安全与第三方密钥
TOKEN_SECRET=
GAODE_KEY=
